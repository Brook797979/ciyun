.porcelain-tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;height:104rpx;box-sizing:content-box;border-radius:30rpx 30rpx 0 0;border-top:1rpx solid #e4d8c6;background:rgba(255,251,244,.98);box-shadow:0 -4rpx 18rpx rgba(33,55,63,.05)}
.porcelain-tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;color:#7c7b75;font-family:"Songti SC","STSong",serif;font-size:24rpx;line-height:1.2}
.porcelain-tab image{width:44rpx;height:44rpx}.porcelain-tab.selected{color:#063d65;font-weight:600}
