<view class="card" bindtap="onTap" aria-role="button" aria-label="查看{{item.name}}">
  <image class="card-image" src="{{item.image}}" mode="aspectFill"/>
  <view class="card-body">
    <view class="card-name">{{item.name}}</view>
    <view class="card-dynasty">{{item.dynasty}}</view>
    <view class="card-arrow" aria-hidden="true">→</view>
  </view>
</view>
