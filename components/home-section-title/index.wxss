.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.heading-main{display:flex;align-items:center;gap:14rpx}.heading-mark{display:flex;align-items:center;justify-content:center;width:50rpx;height:50rpx;color:var(--color-porcelain);background:var(--color-primary);border-radius:50% 50% 44% 56%;font-family:var(--font-family-title);font-size:24rpx;box-shadow:0 8rpx 20rpx rgba(11,65,98,.18)}.heading-title{color:var(--color-ink-blue);font-family:var(--font-family-title);font-size:38rpx;font-weight:700;letter-spacing:2rpx}.heading-action{padding:12rpx 0;color:var(--color-text-secondary);font-size:25rpx}.chevron{margin-left:4rpx;font-size:34rpx}
