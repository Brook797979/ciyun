.video-card{width:300rpx}.video-cover,.inline-video{position:relative;overflow:hidden;width:300rpx;height:174rpx;border-radius:var(--radius-card);background:var(--color-primary-soft);box-shadow:var(--shadow-card)}.video-cover image{width:100%;height:100%}.play{position:absolute;left:18rpx;bottom:16rpx;display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;border:2rpx solid rgba(255,255,255,.9);border-radius:50%;background:rgba(14,38,52,.46);backdrop-filter:blur(4rpx)}.triangle{margin-left:5rpx;width:0;height:0;border-top:12rpx solid transparent;border-bottom:12rpx solid transparent;border-left:18rpx solid #fff}.duration{position:absolute;right:14rpx;bottom:14rpx;padding:4rpx 10rpx;color:#fff;background:rgba(18,29,34,.62);border-radius:999rpx;font-size:21rpx}.video-title{margin:17rpx 8rpx 0;color:var(--color-ink-blue);font-family:var(--font-family-title);font-size:30rpx;font-weight:700}.video-description{margin:7rpx 8rpx 0;color:var(--color-text-secondary);font-size:23rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
