<view class="video-card {{carousel ? 'video-card-carousel' : ''}}"><video wx:if="{{item.src}}" class="inline-video" src="{{item.src}}" poster="{{item.image}}" controls show-center-play-btn object-fit="cover" bindplay="onPlay" bindpause="onPause" bindended="onEnded"/><view wx:else class="video-cover" bindtap="onPlaceholderTap"><image src="{{item.image}}" mode="aspectFill"/><view class="play"><view class="triangle"></view></view><view class="duration">{{item.duration}}</view></view><view class="video-title">{{item.title}}</view><view class="video-description">{{item.description}}</view></view>
