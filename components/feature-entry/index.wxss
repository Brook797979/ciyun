.entry{display:flex;align-items:center;gap:20rpx;padding:24rpx;background:var(--color-surface);border:1rpx solid var(--color-border);border-radius:var(--radius-md)}.marker{display:grid;place-items:center;width:64rpx;height:64rpx;color:var(--color-primary);background:var(--color-primary-soft);border-radius:50%}.content{flex:1}.title{font-weight:600}.description{margin-top:6rpx;color:var(--color-text-secondary);font-size:var(--font-size-caption)}.arrow{color:var(--color-primary);font-size:var(--font-size-caption)}.disabled{opacity:.62}
