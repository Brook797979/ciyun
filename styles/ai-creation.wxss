.creation-page{position:relative;box-sizing:border-box;min-height:100vh;overflow-x:hidden;color:#123c5b;background:#f8f5ee;font-family:"Songti SC","STSong",serif}
.creation-paper,.creation-scene{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.creation-paper{opacity:.55}.creation-scene{z-index:0}
.creation-hero{position:relative;z-index:2}.creation-nav{position:fixed;left:0;right:0;z-index:30}.creation-nav::before{content:"";position:absolute;left:0;right:0;top:-60px;bottom:-8px;background:linear-gradient(180deg,rgba(249,246,239,.96),rgba(249,246,239,.86) 75%,rgba(249,246,239,0));pointer-events:none}
.creation-back{position:absolute;left:18rpx;top:50%;z-index:2;display:flex;align-items:center;justify-content:center;width:44px;height:44px;transform:translateY(-50%)}.creation-back-icon{box-sizing:border-box;width:24rpx;height:24rpx;border-left:3rpx solid #102e43;border-bottom:3rpx solid #102e43;transform:rotate(45deg)}
.creation-nav-title{position:absolute;left:120rpx;right:120rpx;text-align:center;font-size:36rpx;font-weight:700;line-height:1.4;color:#0b2e4b}
.creation-tagline{position:absolute;left:30rpx;right:30rpx;display:flex;align-items:center;justify-content:center;gap:18rpx;text-align:center;color:#31546f;font-size:24rpx;line-height:1.6;letter-spacing:1rpx}.creation-tagline::before,.creation-tagline::after{content:"";flex:none;width:36rpx;height:1rpx;background:linear-gradient(90deg,transparent,#8e9ca2)}.creation-tagline::after{transform:rotate(180deg)}
.creation-content{position:relative;z-index:1;max-width:850rpx;margin:0 auto;padding:0 28rpx;box-sizing:border-box}
.creation-panel{position:relative;box-sizing:border-box;padding:30rpx 26rpx;border:2rpx solid #1d4d70;border-radius:38rpx;background:rgba(255,252,246,.9);box-shadow:0 5rpx 12rpx rgba(45,49,49,.15),0 0 0 4rpx rgba(255,252,246,.9),0 0 0 5rpx rgba(191,152,89,.65)}.creation-panel::before{content:"";position:absolute;inset:6rpx;border:1rpx solid rgba(197,157,92,.56);border-radius:31rpx;pointer-events:none}
.creation-flower{position:absolute;top:-9rpx;left:-8rpx;z-index:2;width:132rpx;height:132rpx;pointer-events:none}.creation-cloud{position:absolute;right:-4rpx;bottom:0;z-index:0;width:116rpx;height:78rpx;opacity:.86;pointer-events:none}
.creation-button{position:relative;display:flex;align-items:center;justify-content:center;gap:17rpx;box-sizing:border-box;width:100%;min-height:94rpx;margin:0;padding:14rpx 30rpx;border:2rpx solid #b8955c;border-radius:46rpx;font-size:34rpx;font-weight:700;line-height:1.4;text-align:center;box-shadow:0 5rpx 10rpx rgba(31,49,64,.14)}.creation-button::after{content:"";position:absolute;inset:5rpx;border:1rpx solid rgba(196,158,96,.8);border-radius:38rpx;pointer-events:none}.creation-button-primary{color:#fffaf0;background:linear-gradient(130deg,#48759c,#204f7b 42%,#123c62)}.creation-button-secondary{color:#123e60;background:rgba(252,248,239,.94);border-color:#205070}.creation-button-disabled{opacity:.58}.creation-button-pressed{opacity:.8;transform:translateY(1rpx)}.creation-button-flower{width:27rpx;height:27rpx;flex:none;opacity:.8}
.creation-feedback{position:relative;margin-top:22rpx;padding:18rpx 22rpx;border:1rpx solid #d8c4a2;border-radius:18rpx;background:rgba(255,251,242,.94);color:#735c43;font-size:24rpx;line-height:1.65}.creation-link{position:relative;display:inline-flex;align-items:center;justify-content:center;padding:12rpx 16rpx;color:#315f80;font-size:24rpx;line-height:1.4}
@media(max-width:350px){.creation-content{padding-left:22rpx;padding-right:22rpx}.creation-panel{padding-left:22rpx;padding-right:22rpx}.creation-tagline{left:20rpx;right:20rpx;gap:12rpx;font-size:23rpx;letter-spacing:0}.creation-tagline::before,.creation-tagline::after{width:24rpx}.creation-button{font-size:31rpx;padding-left:20rpx;padding-right:20rpx;gap:12rpx}}
@media(prefers-reduced-motion:reduce){.result-loading-dots view{animation:none!important}}
