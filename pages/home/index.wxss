.home-page {
  min-height: 100vh;
  overflow-x: hidden;
  background-color: var(--color-page);
  background-image: url('/assets/backgrounds/home-paper.png');
  background-repeat: repeat-y;
  background-size: 100% auto;
}

.hero {
  position: relative;
  overflow: hidden;
  height: 340rpx;
  background: var(--color-silk);
}

.hero-image,
.feature-image,
.ai-background {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-wash {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(248, 241, 230, .98) 0%, rgba(248, 241, 230, .84) 43%, rgba(248, 241, 230, .10) 78%);
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding: 46rpx var(--page-gutter) 30rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-name {
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  line-height: .96;
  text-shadow: 0 2rpx 2rpx rgba(255, 255, 255, .45);
}

.brand-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 52rpx;
  color: #fff;
  background: var(--color-cinnabar);
  border-radius: 6rpx;
  font-family: var(--font-family-title);
  font-size: 19rpx;
}

.brand-subtitle {
  margin-top: 22rpx;
  color: #34332e;
  font-family: var(--font-family-title);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.35;
}

.brand-line {
  width: 48rpx;
  height: 2rpx;
  margin: 18rpx 0 13rpx;
  background: var(--color-warm-gold);
}

.brand-slogan {
  color: #5f5a51;
  font-size: 21rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.home-content {
  position: relative;
  z-index: 3;
  margin-top: -14rpx;
  padding: 0 var(--page-gutter) 48rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: 46fr 54fr;
  gap: 16rpx;
}

.feature-card {
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, .76);
  border-radius: var(--radius-card-lg);
  box-shadow: var(--shadow-card);
}

.feature-identify { height: 218rpx; }
.feature-craft { height: 252rpx; }
.feature-challenge { height: 236rpx; margin-top: -18rpx; }
.feature-video { height: 210rpx; }

.feature-craft,
.feature-challenge {
  border-color: rgba(255, 248, 236, .90);
  box-shadow: 0 14rpx 32rpx rgba(48, 40, 34, .14);
}

.feature-cover {
  position: absolute;
  top: 0;
  right: 32%;
  bottom: 0;
  left: 0;
}

.tone-blue .feature-cover {
  background: linear-gradient(90deg, rgba(7, 52, 79, .96) 0%, rgba(11, 65, 98, .86) 70%, rgba(11, 65, 98, 0) 100%);
}

.tone-ivory .feature-cover {
  right: 27%;
  background: linear-gradient(90deg, rgba(247, 231, 207, .98) 0%, rgba(247, 231, 207, .88) 70%, rgba(247, 231, 207, 0) 100%);
}

.tone-red .feature-cover {
  background: linear-gradient(90deg, rgba(143, 49, 42, .96) 0%, rgba(163, 68, 52, .87) 70%, rgba(163, 68, 52, 0) 100%);
}

.feature-copy {
  position: relative;
  z-index: 2;
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  height: 100%;
  padding: 25rpx 18rpx 20rpx 23rpx;
  color: #fff;
}

.tone-ivory .feature-copy { color: #3f2a21; }

.feature-title {
  font-family: var(--font-family-title);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.feature-description {
  max-width: 190rpx;
  margin-top: 10rpx;
  white-space: pre-line;
  font-size: 21rpx;
  line-height: 1.45;
  letter-spacing: .5rpx;
}

.feature-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-top: auto;
  color: var(--color-primary);
  background: rgba(255, 252, 245, .96);
  border-radius: 50%;
  font-size: 29rpx;
  box-shadow: 0 7rpx 16rpx rgba(0, 0, 0, .12);
}

.tone-ivory .feature-action { color: var(--color-cinnabar); }

.feature-video-player {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-card-lg);
}

.sr-only {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
}

.ai-card {
  position: relative;
  overflow: hidden;
  height: 190rpx;
  margin-top: 28rpx;
  border: 1rpx solid rgba(130, 152, 158, .30);
  border-radius: var(--radius-card-lg);
  box-shadow: var(--shadow-card);
}

.ai-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, #f8f2e6 0%, rgba(248, 242, 230, .98) 65%, rgba(248, 242, 230, .76) 78%, rgba(248, 242, 230, 0) 96%);
}

.ai-content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 76%;
  padding: 22rpx 22rpx 20rpx;
}

.ai-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ai-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 43rpx;
  height: 35rpx;
  border: 3rpx solid var(--color-primary);
  border-radius: 17rpx;
}

.ai-dot {
  width: 5rpx;
  height: 5rpx;
  background: var(--color-primary);
  border-radius: 50%;
}

.ai-prompt {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 8rpx 8rpx 8rpx 18rpx;
  background: rgba(255, 252, 247, .95);
  border: 1rpx solid rgba(178, 157, 130, .38);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(68, 53, 39, .08);
}

.ai-question {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ai-button {
  flex: none;
  padding: 12rpx 20rpx;
  color: #fff;
  background: var(--color-primary);
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.home-section { margin-top: 40rpx; }
.news-section { margin-top: 40rpx; }

.home-news-swiper {
  height: 400rpx;
  margin-right: -28rpx;
}

.home-news-swiper swiper-item {
  box-sizing: border-box;
  padding: 0 16rpx 26rpx 0;
}

@media (max-width: 350px) {
  .hero { height: 322rpx; }
  .hero-copy { padding-top: 40rpx; }
  .brand-name { font-size: 72rpx; }
  .brand-subtitle { font-size: 24rpx; letter-spacing: 3rpx; }
  .brand-slogan { font-size: 19rpx; letter-spacing: 1rpx; }
  .feature-title { font-size: 30rpx; }
  .feature-description { max-width: 164rpx; font-size: 19rpx; }
  .feature-copy { padding-left: 19rpx; }
  .ai-content { width: 80%; padding-left: 18rpx; }
  .ai-heading { font-size: 29rpx; }
  .ai-question { font-size: 19rpx; }
  .ai-button { padding-right: 16rpx; padding-left: 16rpx; font-size: 20rpx; }
}
