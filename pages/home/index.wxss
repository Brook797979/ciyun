.home-page{min-height:100vh;overflow-x:hidden;background-color:var(--color-page);background-image:url('/assets/backgrounds/home-paper.png');background-repeat:repeat-y;background-size:100% auto}.hero{position:relative;overflow:hidden;height:390rpx;background:var(--color-silk)}.hero-image{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}.hero-wash{position:absolute;top:0;right:0;bottom:0;left:0;background:linear-gradient(90deg,rgba(248,241,230,.98) 0%,rgba(248,241,230,.82) 42%,rgba(248,241,230,.06) 77%)}.hero-copy{position:relative;z-index:2;padding:66rpx var(--page-gutter) 42rpx}.brand-row{display:flex;align-items:center;gap:16rpx}.brand-name{color:var(--color-ink-blue);font-family:var(--font-family-title);font-size:86rpx;font-weight:800;letter-spacing:12rpx;line-height:1}.brand-seal{display:flex;align-items:center;justify-content:center;width:36rpx;height:56rpx;color:#fff;background:var(--color-cinnabar);border-radius:6rpx;font-family:var(--font-family-title);font-size:20rpx}.brand-subtitle{margin-top:30rpx;color:var(--color-text-primary);font-family:var(--font-family-title);font-size:27rpx;letter-spacing:5rpx}.brand-line{width:50rpx;height:2rpx;margin:23rpx 0 16rpx;background:var(--color-warm-gold)}.brand-slogan{color:var(--color-text-secondary);font-size:20rpx;letter-spacing:3rpx}.home-content{position:relative;z-index:3;margin-top:-16rpx;padding:0 var(--page-gutter) 64rpx}.feature-grid{display:grid;grid-template-columns:46fr 54fr;gap:16rpx}.feature-card{position:relative;overflow:hidden;border:2rpx solid rgba(255,255,255,.78);border-radius:var(--radius-card-lg);box-shadow:var(--shadow-card)}.feature-identify{height:224rpx}.feature-craft{height:264rpx}.feature-challenge{height:248rpx;margin-top:-24rpx}.feature-video{height:208rpx}.feature-image,.ai-background{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}.feature-cover{position:absolute;top:0;right:34%;bottom:0;left:0}.tone-blue .feature-cover{background:linear-gradient(90deg,#0a3752 0%,#0d4460 70%,rgba(13,68,96,0) 100%)}.tone-ivory .feature-cover{right:28%;background:linear-gradient(90deg,#f7e7cf 0%,#f7e7cf 70%,rgba(247,231,207,0) 100%)}.tone-red .feature-cover{background:linear-gradient(90deg,#9a392f 0%,#a34434 70%,rgba(163,68,52,0) 100%)}.feature-copy{position:relative;z-index:2;display:flex;box-sizing:border-box;flex-direction:column;height:100%;padding:28rpx 18rpx 22rpx 24rpx;color:#fff}.tone-ivory .feature-copy{color:#3f2a21}.feature-title{font-family:var(--font-family-title);font-size:36rpx;font-weight:700;letter-spacing:2rpx;white-space:nowrap}.feature-description{margin-top:12rpx;white-space:pre-line;font-size:22rpx;line-height:1.48;letter-spacing:1rpx}.feature-action{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;margin-top:auto;color:var(--color-primary);background:rgba(255,252,245,.94);border-radius:50%;font-size:30rpx;box-shadow:0 8rpx 18rpx rgba(0,0,0,.12)}.tone-ivory .feature-action{color:var(--color-cinnabar)}.sr-only{position:absolute;width:1rpx;height:1rpx;overflow:hidden;opacity:0}.ai-card{position:relative;overflow:hidden;height:206rpx;margin-top:30rpx;border:1rpx solid rgba(130,152,158,.3);border-radius:var(--radius-card-lg);box-shadow:var(--shadow-card)}.ai-overlay{position:absolute;top:0;right:0;bottom:0;left:0;background:linear-gradient(90deg,#f8f2e6 0%,#f8f2e6 82%,rgba(248,242,230,0) 96%)}.ai-content{position:relative;z-index:2;box-sizing:border-box;width:78%;padding:26rpx}.ai-heading{display:flex;align-items:center;gap:14rpx;color:var(--color-ink-blue);font-family:var(--font-family-title);font-size:34rpx;font-weight:700}.ai-icon{display:flex;align-items:center;justify-content:center;gap:4rpx;width:46rpx;height:38rpx;border:3rpx solid var(--color-primary);border-radius:18rpx}.ai-dot{width:5rpx;height:5rpx;background:var(--color-primary);border-radius:50%}.ai-prompt{display:flex;align-items:center;gap:12rpx;margin-top:22rpx;padding:10rpx 10rpx 10rpx 22rpx;background:rgba(255,252,247,.92);border:1rpx solid rgba(178,157,130,.4);border-radius:999rpx;box-shadow:0 8rpx 18rpx rgba(68,53,39,.08)}.ai-question{flex:1;overflow:hidden;color:var(--color-text-secondary);font-size:22rpx;white-space:nowrap;text-overflow:ellipsis}.ai-button{flex:none;padding:14rpx 23rpx;color:#fff;background:var(--color-primary);border-radius:999rpx;font-size:23rpx}.home-section{margin-top:46rpx}.horizontal-scroll{width:calc(100% + 28rpx);margin-right:-28rpx}.scroll-row{display:inline-flex;gap:20rpx;padding-right:28rpx;padding-bottom:10rpx}.news-section{margin-top:54rpx}.home-news-swiper{height:520rpx;margin-right:-28rpx}.home-news-swiper swiper-item{box-sizing:border-box;padding-bottom:34rpx}@media (max-width:350px){.feature-title{font-size:32rpx}.feature-description{font-size:20rpx}.brand-name{font-size:76rpx}.ai-content{width:84%}}
.feature-video-player{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;border-radius:var(--radius-card-lg)}.feature-play{padding-left:4rpx;color:#fff;background:rgba(11,65,98,.78);border:2rpx solid rgba(255,255,255,.88);font-size:23rpx}
