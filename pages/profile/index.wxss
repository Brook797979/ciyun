page { background:#F8F1E6; }
.profile-page { min-height:100vh; overflow-x:hidden; color:#103B5A; background:#F8F1E6; }
.profile-page button { box-sizing:border-box; min-width:0; margin:0; padding:0; border:0; background:transparent; color:inherit; font-family:inherit; font-weight:400; line-height:1.5; }
.profile-page button::after { border:0; }
.profile-hero { position:relative; overflow:hidden; }
.hero-landscape,.hero-mist { position:absolute; inset:0; width:100%; height:100%; }
.hero-landscape { object-position:center 45%; opacity:.68; }
.hero-mist { background:linear-gradient(180deg,rgba(248,241,230,.12),rgba(248,241,230,.4) 60%,#F8F1E6); }
.profile-nav { position:absolute; left:210rpx; right:210rpx; display:flex; align-items:center; justify-content:center; font-family:var(--font-family-title); font-size:40rpx; font-weight:600; letter-spacing:5rpx; }
.profile-body { position:relative; padding:0 25rpx 18rpx; }
.porcelain-panel { position:relative; box-sizing:border-box; margin-bottom:20rpx; overflow:hidden; border:1rpx solid #C9B087; border-radius:22rpx; background:rgba(255,252,247,.88); box-shadow:inset 0 0 0 5rpx rgba(255,255,255,.62),0 4rpx 9rpx rgba(75,65,45,.06); }
.porcelain-panel::after { position:absolute; inset:7rpx; border:1rpx solid rgba(202,178,139,.22); border-radius:16rpx; pointer-events:none; content:''; }
.identity-card { min-height:338rpx; padding:26rpx 28rpx 22rpx; border-color:#C5A06D; background:linear-gradient(115deg,rgba(255,252,242,.96),rgba(250,244,229,.85)); }
.identity-copy { position:relative; z-index:1; width:calc(100% - 270rpx); }
.identity-heading { display:flex; align-items:center; gap:10rpx; font-family:var(--font-family-title); font-size:28rpx; font-weight:600; letter-spacing:2rpx; white-space:nowrap; }
.section-mark { flex:none; color:#345774; font-size:30rpx; line-height:1; }
.identity-seal { margin-left:2rpx; padding:2rpx; border:1rpx solid #AC4B3A; border-radius:3rpx; color:#AC4B3A; font-size:12rpx; font-weight:400; line-height:1.1; writing-mode:vertical-rl; letter-spacing:0; }
.identity-title { margin-top:16rpx; font-family:"STKaiti","KaiTi",var(--font-family-title); font-size:47rpx; font-weight:600; line-height:1.35; letter-spacing:3rpx; white-space:nowrap; }
.identity-motto { margin-top:9rpx; color:#7B817D; font-family:var(--font-family-title); font-size:21rpx; line-height:1.6; letter-spacing:2rpx; white-space:nowrap; }
.identity-growth { display:flex; align-items:baseline; justify-content:space-between; gap:8rpx; margin-top:24rpx; }
.identity-level { flex:none; color:#B18A51; font-family:Georgia,serif; font-size:29rpx; line-height:1; white-space:nowrap; }
.identity-level text { padding-left:5rpx; font-size:52rpx; }
.identity-xp { color:#354F60; font-size:19rpx; line-height:1.6; white-space:nowrap; }
.identity-xp text { font-family:Georgia,serif; font-size:22rpx; }
.identity-xp .highest-level { font-family:var(--font-family-title); font-size:18rpx; }
.identity-track { height:12rpx; margin-top:10rpx; overflow:hidden; border:1rpx solid #B8B9AF; border-radius:12rpx; background:#DADDD9; }
.identity-fill { height:100%; border-radius:inherit; background:linear-gradient(90deg,#6389AB,#335D80); }
.identity-landscape { position:absolute; top:15rpx; right:-3rpx; width:288rpx; height:288rpx; }
.identity-days { position:relative; z-index:1; display:flex; align-items:center; gap:13rpx; margin-top:25rpx; font-family:var(--font-family-title); font-size:22rpx; letter-spacing:1rpx; }
.days-flower { color:#A98954; font-size:33rpx; line-height:1; }
.days-value { padding:0 3rpx; font-family:Georgia,serif; font-size:28rpx; }
.panel-heading { position:relative; z-index:1; display:flex; align-items:center; gap:12rpx; padding:22rpx 24rpx 0; }
.panel-title { flex:none; font-family:var(--font-family-title); font-size:31rpx; font-weight:600; letter-spacing:3rpx; }
.heading-rule { flex:1; min-width:8rpx; height:1rpx; background:#D2BC98; }
.panel-caption { flex:none; color:#92948B; font-family:var(--font-family-title); font-size:20rpx; line-height:1.5; letter-spacing:1rpx; white-space:nowrap; }
.footprints-grid { display:flex; padding:24rpx 15rpx 28rpx; }
.profile-page button.footprint-item { display:flex; flex:1; align-items:center; justify-content:center; gap:13rpx; width:0; max-width:100%; min-height:92rpx; border-right:1rpx solid #DCCCAF; border-radius:0; text-align:left; }
.profile-page button.footprint-item:last-child { border-right:0; }
.footprint-item image { flex:none; width:54rpx; height:64rpx; }
.footprint-count { font-family:Georgia,serif; font-size:49rpx; line-height:1; }
.footprint-label { margin-top:9rpx; font-family:var(--font-family-title); font-size:21rpx; line-height:1.5; white-space:nowrap; }
.growth-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24rpx 16rpx; padding:26rpx 20rpx 30rpx; }
.profile-page button.growth-badge { display:flex; flex-direction:column; align-items:center; width:100%; max-width:100%; overflow:visible; }
.growth-art { position:relative; width:174rpx; height:174rpx; }
.growth-art image { display:block; width:100%; height:100%; filter:drop-shadow(0 4rpx 3rpx rgba(58,67,64,.12)); }
.growth-locked .growth-art image,.dialog-locked image { filter:grayscale(.9) saturate(.25) contrast(.86); opacity:.63; }
.growth-lock { position:absolute; left:calc(50% - 17rpx); bottom:3rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:34rpx; height:34rpx; border:3rpx solid #F9F5EB; border-radius:50%; background:#7E929D; }
.lock-icon { position:relative; width:12rpx; height:10rpx; margin-top:5rpx; border-radius:2rpx; background:#FFFDF7; }
.lock-icon::before { position:absolute; top:-8rpx; left:2rpx; box-sizing:border-box; width:8rpx; height:10rpx; border:2rpx solid #FFFDF7; border-radius:8rpx 8rpx 0 0; content:''; }
.lock-icon::after { position:absolute; top:4rpx; left:5rpx; width:2rpx; height:4rpx; background:#7E929D; content:''; }
.growth-name { box-sizing:border-box; min-width:174rpx; margin-top:2rpx; padding:5rpx 10rpx; border:1rpx solid #CFB386; border-radius:8rpx 8rpx 18rpx 18rpx; background:linear-gradient(180deg,#FFFDF8,#F6EFDF); box-shadow:0 2rpx 4rpx rgba(80,70,48,.06); font-family:var(--font-family-title); font-size:25rpx; font-weight:600; line-height:1.5; white-space:nowrap; }
.growth-locked .growth-name { border-color:#D2C9B8; color:#6F7E84; background:#F4F1E8; }
.journal-landscape { position:absolute; right:-45rpx; bottom:-8rpx; width:380rpx; height:240rpx; opacity:.15; pointer-events:none; }
.journal-list { position:relative; padding:20rpx 27rpx 25rpx; }
.journal-row { position:relative; display:flex; align-items:center; gap:13rpx; min-height:69rpx; padding:8rpx 0 8rpx 25rpx; box-sizing:border-box; }
.journal-row::before { position:absolute; top:0; bottom:0; left:5rpx; width:1rpx; background:#C6CDD0; content:''; }
.journal-row:first-child::before { top:50%; }.journal-row:last-child::before { bottom:50%; }
.journal-dot { position:absolute; z-index:1; left:0; top:calc(50% - 5rpx); width:11rpx; height:11rpx; border-radius:50%; background:#446D90; }
.journal-date { display:flex; flex:none; flex-direction:column; width:80rpx; color:#818C91; font-family:Georgia,serif; font-size:22rpx; line-height:1.35; }
.journal-year { color:#A7ABA4; font-size:16rpx; }
.journal-title { flex:1; min-width:0; color:#354F60; font-family:var(--font-family-title); font-size:24rpx; line-height:1.7; word-break:break-all; }
.journal-icon { flex:none; width:40rpx; height:43rpx; opacity:.76; }
.journal-empty { position:relative; padding:36rpx 40rpx 43rpx; color:#8A948F; font-family:var(--font-family-title); font-size:24rpx; line-height:1.9; text-align:center; }
.journal-empty text { display:block; }
.profile-page button.profile-warning { width:100%; max-width:100%; padding:12rpx; color:#9B7547; font-size:22rpx; }
.local-note { padding:3rpx 0 8rpx; color:#A1A49B; font-size:19rpx; line-height:1.5; text-align:center; letter-spacing:1rpx; }
.badge-mask { position:fixed; inset:0; z-index:100; display:flex; align-items:center; justify-content:center; box-sizing:border-box; padding:24rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); background:rgba(13,40,55,.45); }
.badge-dialog { position:relative; display:flex; flex-direction:column; box-sizing:border-box; width:620rpx; max-width:100%; height:860rpx; max-height:100%; overflow:hidden; border:1rpx solid #C6AA7D; border-radius:24rpx; background:#FFFCF7; box-shadow:inset 0 0 0 6rpx #F4EBDD,0 18rpx 60rpx rgba(14,40,54,.18); }
.profile-page button.dialog-close { position:absolute; top:6rpx; right:6rpx; z-index:2; display:flex; align-items:center; justify-content:center; width:44px; min-width:44px; max-width:44px; height:44px; color:#72828A; font-family:Arial,sans-serif; font-size:28px; font-weight:300; line-height:44px; }
.badge-dialog-body { flex:1; width:100%; height:0; min-height:0; text-align:center; }
.dialog-art { width:220rpx; height:220rpx; margin:32rpx auto 0; }.dialog-art image { width:100%; height:100%; }
.dialog-name { margin-top:8rpx; color:#103B5A; font-family:var(--font-family-title); font-size:37rpx; font-weight:600; letter-spacing:3rpx; }
.dialog-state { margin-top:9rpx; color:#A58450; font-size:22rpx; letter-spacing:2rpx; }
.dialog-condition { margin:20rpx 40rpx 0; color:#7B8786; font-size:24rpx; line-height:1.8; }
.dialog-progress { margin-top:18rpx; color:#7C8B8F; font-size:22rpx; }.dialog-progress text { color:#315E7B; font-family:Georgia,serif; font-size:26rpx; }
.dialog-track { height:7rpx; margin:13rpx 44rpx 28rpx; overflow:hidden; border-radius:7rpx; background:#E2E6DF; }.dialog-track view { height:100%; border-radius:inherit; background:#456D8B; }
.dialog-footer { flex:none; padding:16rpx 30rpx 28rpx; }
.profile-page button.dialog-primary { width:100%; max-width:100%; min-height:44px; padding:16rpx; border:1rpx solid #B39666; border-radius:12rpx; color:#FFF9EF; background:#103F61; font-family:var(--font-family-title); font-size:27rpx; letter-spacing:3rpx; }
@media(max-width:350px) { .panel-heading { gap:9rpx; padding-left:21rpx; padding-right:21rpx; }.panel-title { font-size:30rpx; letter-spacing:2rpx; }.panel-caption { font-size:19rpx; letter-spacing:0; }.identity-title { font-size:44rpx; letter-spacing:1rpx; }.identity-motto { font-size:20rpx; letter-spacing:1rpx; }.identity-xp { font-size:18rpx; }.footprint-item image { width:47rpx; }.profile-page button.footprint-item { gap:8rpx; }.growth-name { font-size:24rpx; } }
