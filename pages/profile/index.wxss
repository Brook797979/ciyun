.profile{display:flex;align-items:center;gap:24rpx;padding:32rpx}.avatar{display:grid;place-items:center;width:96rpx;height:96rpx;color:var(--color-primary);background:var(--color-primary-soft);border-radius:50%}.name{font-family:var(--font-family-title);font-size:var(--font-size-subtitle)}.menu{overflow:hidden}.menu-item{display:flex;justify-content:space-between;padding:26rpx;border-bottom:1rpx solid var(--color-border)}.menu-item:last-child{border-bottom:0}
