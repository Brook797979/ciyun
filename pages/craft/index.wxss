.craft-page {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--color-ink-blue);
  background: var(--color-page);
}
.craft-paper { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.22; pointer-events: none; }
.craft-hero { position: relative; flex: none; overflow: hidden; }
.craft-hero-image, .craft-hero-wash { position: absolute; inset: 0; width: 100%; height: 100%; }
.craft-hero-wash { background: linear-gradient(90deg, rgba(248, 241, 230, 0.12), transparent 76%), linear-gradient(180deg, transparent 68%, var(--color-page)); }
.craft-navigation { position: absolute; left: 28rpx; right: 28rpx; z-index: 2; }
.craft-back { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 100%; min-height: 44rpx; }
.back-chevron { width: 20rpx; height: 20rpx; border-left: 3rpx solid var(--color-ink-blue); border-bottom: 3rpx solid var(--color-ink-blue); transform: rotate(45deg); }
.craft-brand { position: absolute; left: 54rpx; z-index: 1; }
.craft-brand-row { display: flex; align-items: center; gap: 16rpx; }
.craft-brand-title { font-family: "STKaiti", "KaiTi", var(--font-family-title); font-size: 90rpx; font-weight: 800; line-height: 1.15; letter-spacing: 3rpx; text-shadow: 0 2rpx 2rpx rgba(255, 252, 247, 0.7); }
.craft-brand-seal { box-sizing: border-box; width: 26rpx; padding: 8rpx 5rpx; border-radius: 7rpx; color: #FFF8EB; background: var(--color-cinnabar); font-family: var(--font-family-title); font-size: 17rpx; line-height: 1.05; text-align: center; }
.craft-brand-subtitle { margin-top: 12rpx; font-family: var(--font-family-title); font-size: 22rpx; line-height: 1.5; letter-spacing: 3rpx; white-space: nowrap; }

.craft-progress { position: relative; display: flex; flex: none; padding: 0 48rpx 16rpx; }
.craft-step { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; color: var(--color-text-secondary); }
.craft-step:not(:last-child)::after { position: absolute; top: 24rpx; left: calc(50% + 28rpx); right: calc(-50% + 28rpx); height: 1rpx; background: rgba(119, 114, 104, 0.38); content: ""; }
.step-number { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 48rpx; height: 48rpx; border: 1rpx solid var(--color-border); border-radius: 50%; box-shadow: inset 0 0 0 3rpx rgba(255, 252, 247, 0.75); background: rgba(255, 252, 247, 0.7); font-family: var(--font-family-title); font-size: 25rpx; }
.step-label { margin-top: 7rpx; font-family: var(--font-family-title); font-size: 21rpx; line-height: 1.4; white-space: nowrap; }
.craft-step-active { color: var(--color-primary); }
.craft-step-active .step-number { color: var(--color-porcelain); border-color: var(--color-primary); background: var(--color-primary); box-shadow: inset 0 0 0 3rpx rgba(255, 252, 247, 0.56); }
.craft-step-active .step-label { font-weight: 700; }
.craft-step-active::after { background: var(--color-primary) !important; }
.craft-step-done { color: var(--color-primary); }
.craft-step-done .step-number { color: var(--color-primary); border-color: var(--color-primary); background: rgba(255, 252, 247, 0.9); }
.craft-step-done::after { background: var(--color-primary) !important; }

.craft-content { position: relative; display: flex; flex: 1; flex-direction: column; box-sizing: border-box; padding: 0 28rpx 22rpx; }
.shape-preview { position: relative; flex: none; height: 400rpx; overflow: hidden; border-radius: 20rpx; background: var(--color-silk); box-shadow: 0 6rpx 18rpx rgba(50, 47, 39, 0.08); }
.shape-preview-image, .preview-wash { position: absolute; inset: 0; width: 100%; height: 100%; }
.shape-preview-stage { position: absolute; inset: 0; transform-origin: 50% 50%; }
.pattern-surface { position: absolute; overflow: hidden; opacity: 0.86; mix-blend-mode: multiply; pointer-events: none; -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); }
.pattern-texture { display: block; width: 100%; height: 100%; }
.pattern-shading { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(40, 52, 64, 0.22), rgba(255, 255, 255, 0.18) 34%, rgba(255, 255, 255, 0) 52%, rgba(40, 52, 64, 0.26)); }
.preview-wash { background: linear-gradient(90deg, rgba(7, 57, 88, 0.56), rgba(7, 57, 88, 0.08) 18%, transparent 32%); pointer-events: none; }
.preview-poem { position: absolute; top: 40rpx; left: 24rpx; display: flex; flex-direction: row-reverse; gap: 6rpx; max-height: 238rpx; color: rgba(255, 252, 247, 0.65); font-family: var(--font-family-title); font-size: 16rpx; font-weight: 400; line-height: 1.3; pointer-events: none; }
.preview-poem text { display: block; width: 18rpx; word-break: break-all; }
.preview-cloud { position: absolute; bottom: -30rpx; left: -34rpx; width: 170rpx; height: 106rpx; opacity: 0.7; pointer-events: none; }
.preview-cloud view { position: absolute; width: 84rpx; height: 68rpx; border: 2rpx solid #D2AB72; border-radius: 50%; background: rgba(50, 100, 133, 0.6); box-shadow: inset 0 0 0 7rpx rgba(50, 100, 133, 0.55), inset 0 0 0 9rpx rgba(210, 171, 114, 0.72); }
.preview-cloud view:nth-child(2) { left: 46rpx; top: 21rpx; }
.preview-cloud view:nth-child(3) { left: 98rpx; top: 40rpx; }

.shape-section-heading { display: flex; flex: none; align-items: center; gap: 10rpx; height: 65rpx; min-width: 0; }
.shape-section-icon { flex: none; width: 38rpx; height: 38rpx; }
.shape-section-title { flex: none; font-family: var(--font-family-title); font-size: 28rpx; font-weight: 700; }
.shape-section-rule { flex: 1; min-width: 16rpx; height: 1rpx; background: rgba(7, 57, 88, 0.32); }
.shape-section-caption { flex: none; color: var(--color-text-secondary); font-family: var(--font-family-title); font-size: 17rpx; }
.shape-scroll { flex: none; width: 100%; white-space: nowrap; }
.shape-list { display: flex; align-items: stretch; gap: 14rpx; padding: 2rpx 2rpx 5rpx; }
.shape-card { position: relative; flex: none; box-sizing: border-box; width: 204rpx; height: 344rpx; overflow: hidden; border: 2rpx solid transparent; border-radius: 16rpx; background: rgba(255, 252, 247, 0.9); white-space: normal; }
.shape-card-selected { border-color: var(--color-primary); box-shadow: 0 0 0 1rpx rgba(11, 65, 98, 0.12); }
.shape-card-cover { position: relative; height: 190rpx; overflow: hidden; border-radius: 12rpx; }
.shape-card-image { display: block; width: 100%; height: 100%; }
.shape-card-copy { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; height: 150rpx; padding: 9rpx 8rpx 8rpx; text-align: center; }
.shape-card-name { flex: none; font-family: var(--font-family-title); font-size: 26rpx; font-weight: 700; line-height: 1.2; }
.shape-card-description { flex: none; margin-top: 6rpx; color: var(--color-text-secondary); font-family: var(--font-family-title); font-size: 20rpx; line-height: 1.3; white-space: pre-line; }
.shape-unlock-note { display: flex; flex: none; align-items: center; justify-content: center; gap: 7rpx; box-sizing: border-box; width: 168rpx; max-width: 100%; height: 28rpx; margin-top: auto; padding: 0 9rpx; border-radius: 20rpx; color: #8B5D2B; background: #F4DEBB; font-size: 18rpx; line-height: 1; white-space: nowrap; }
.shape-unlock-icon { position: relative; flex: none; width: 11rpx; height: 10rpx; margin-top: 4rpx; border-radius: 2rpx; background: currentColor; }
.shape-unlock-icon::before { position: absolute; left: 1rpx; top: -7rpx; box-sizing: border-box; width: 9rpx; height: 9rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 7rpx 7rpx 0 0; content: ""; }
.shape-card-locked .shape-card-image { opacity: 0.94; }
.pattern-card .pattern-card-cover { background: radial-gradient(circle at 50% 40%, #FFFCF7, #EFE7DA); }
.pattern-card.shape-card-locked .shape-card-image { opacity: 1; }
.glaze-card .shape-card-description { font-size: 18rpx; line-height: 1.35; }
.glaze-card.shape-card-locked .shape-card-image { opacity: 1; }
.glaze-card-cover { background: var(--color-silk); }
.shape-status { position: absolute; top: 7rpx; right: 7rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 29rpx; height: 29rpx; border: 1rpx solid rgba(255, 252, 247, 0.85); border-radius: 50%; }
.shape-status-selected { background: var(--color-primary); }
.shape-status-locked { background: rgba(43, 39, 34, 0.6); }
.shape-check { width: 12rpx; height: 7rpx; margin-top: -3rpx; border-left: 2rpx solid #FFFCF7; border-bottom: 2rpx solid #FFFCF7; transform: rotate(-45deg); }
.shape-lock { position: relative; width: 11rpx; height: 9rpx; margin-top: 4rpx; border: 1.5rpx solid #FFFCF7; border-radius: 2rpx; }
.shape-lock::before { position: absolute; left: 1rpx; top: -8rpx; width: 6rpx; height: 7rpx; border: 1.5rpx solid #FFFCF7; border-bottom: 0; border-radius: 7rpx 7rpx 0 0; content: ""; }

.craft-actions { display: flex; flex: none; gap: 16rpx; margin-top: 20rpx; padding-top: 0; }
.craft-action { display: flex; flex: 1; align-items: center; justify-content: center; box-sizing: border-box; min-width: 0; height: 66rpx; margin: 0; padding: 0 18rpx; border-radius: 38rpx; font-family: var(--font-family-title); font-size: 29rpx; font-weight: 700; line-height: 1; letter-spacing: 3rpx; }
.craft-previous { color: var(--color-primary); border: 1rpx solid var(--color-primary); background: rgba(255, 252, 247, 0.86); }
.craft-previous-pressed { background: rgba(11, 65, 98, 0.08); }
.craft-previous[disabled] { color: #AAA397; border: 1rpx solid var(--color-border); background: rgba(255, 252, 247, 0.56); }
.craft-next { gap: 20rpx; color: var(--color-porcelain); background: linear-gradient(110deg, #326D95, var(--color-ink-blue)); box-shadow: 0 5rpx 12rpx rgba(7, 57, 88, 0.12); }
.next-chevron { width: 11rpx; height: 11rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(45deg); }
.craft-next-pressed { opacity: 0.86; }
.craft-pressed, .shape-card-pressed { opacity: 0.8; }

.craft-content-finish .shape-section-heading { height: 66rpx; margin: 4rpx 0; }
.craft-content-finish .craft-actions { margin-top: 22rpx; }
.finish-panel { flex: none; box-sizing: border-box; padding: 18rpx 20rpx 12rpx; border: 1rpx solid rgba(217, 205, 187, 0.8); border-radius: 16rpx; background: rgba(255, 252, 247, 0.9); }
.finish-details { display: flex; gap: 12rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--color-border); }
.finish-detail { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; box-sizing: border-box; padding: 8rpx 8rpx 10rpx; overflow: hidden; border: 1rpx solid #E4D9C8; border-radius: 10rpx; background: #F8F1E6; }
.finish-detail-cover { flex: none; width: 100%; height: 104rpx; overflow: hidden; border-radius: 6rpx; }
.finish-shape-cover { background: var(--color-silk); }
.finish-pattern-cover { background: #F6F0E6; }
.finish-detail-image { display: block; width: 100%; height: 100%; }
.finish-detail-label { margin-top: 9rpx; color: var(--color-text-secondary); font-size: 18rpx; line-height: 1.3; letter-spacing: 3rpx; }
.finish-detail-value { max-width: 100%; margin-top: 3rpx; color: var(--color-ink-blue); font-family: var(--font-family-title); font-size: 24rpx; line-height: 1.4; text-align: center; }
.finish-name-row { display: flex; align-items: center; justify-content: space-between; margin: 18rpx 0 12rpx; }
.finish-name-label { font-family: var(--font-family-title); font-size: 24rpx; font-weight: 700; }
.finish-name-hint { color: var(--color-text-secondary); font-size: 18rpx; }
.finish-name-field { position: relative; box-sizing: border-box; height: 72rpx; overflow: hidden; border: 1rpx solid #CDBDA4; border-radius: 10rpx; background: #F3E9D9; box-shadow: inset 0 1rpx 2rpx rgba(116, 91, 53, 0.04); }
.finish-name-field-disabled { opacity: 0.65; }
.finish-name-input { box-sizing: border-box; width: 100%; height: 100%; padding: 0 60rpx 0 20rpx; color: var(--color-ink-blue); background: transparent; font-family: var(--font-family-title); font-size: 26rpx; }
.finish-name-placeholder { color: #938573; font-size: 24rpx; }
.finish-name-icon { position: absolute; top: 23rpx; right: 25rpx; box-sizing: border-box; width: 9rpx; height: 23rpx; border: 1.5rpx solid #977C55; border-radius: 2rpx 2rpx 0 0; transform: rotate(40deg); pointer-events: none; }
.finish-name-icon::before { position: absolute; top: 4rpx; left: 0; right: 0; border-top: 1rpx solid #977C55; content: ""; }
.finish-name-icon::after { position: absolute; bottom: -6rpx; left: -1.5rpx; width: 0; height: 0; border-left: 4.5rpx solid transparent; border-right: 4.5rpx solid transparent; border-top: 5rpx solid #977C55; content: ""; }
.finish-note-row { display: flex; align-items: center; justify-content: space-between; min-height: 42rpx; padding-top: 8rpx; }
.finish-status { color: var(--color-text-secondary); font-size: 20rpx; }
.finish-status-saved { color: #3E725E; }
.finish-edit { padding: 8rpx 0 8rpx 18rpx; color: var(--color-primary); font-size: 21rpx; text-decoration: underline; }

.craft-tabbar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; box-sizing: content-box; height: 104rpx; overflow: hidden; border-top: 1rpx solid rgba(217, 205, 187, 0.65); border-radius: 34rpx 34rpx 0 0; background: rgba(255, 252, 247, 0.98); box-shadow: 0 -5rpx 18rpx rgba(50, 47, 39, 0.05); }
.craft-tab { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--color-text-secondary); font-family: var(--font-family-title); font-size: 23rpx; line-height: 1.25; }
.craft-tab-icon { width: 44rpx; height: 44rpx; }
.craft-tab-active { color: var(--color-primary); font-weight: 700; }
.craft-tab-indicator { position: absolute; bottom: 6rpx; width: 38rpx; height: 4rpx; border-radius: 4rpx; background: var(--color-primary); }

@media (max-width: 350px) {
  .craft-brand { left: 46rpx; }
  .craft-brand-title { font-size: 86rpx; }
  .craft-brand-subtitle { font-size: 21rpx; letter-spacing: 2rpx; }
  .shape-section-caption { font-size: 16rpx; }
}
