.works-page {
  max-width: var(--content-max-width);
  margin: 0 auto;
}

.work-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.collection-count {
  margin-bottom: -8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-caption);
}

.work { overflow: hidden; }

.work-preview {
  display: block;
  width: 100%;
  height: 390rpx;
  background: var(--color-porcelain);
}

.work-copy { padding: 22rpx 26rpx 24rpx; }

.work-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.work-name {
  flex: 1;
  min-width: 0;
  color: var(--color-primary);
  font-family: var(--font-family-title);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.work-date {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.work-details {
  display: flex;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.work-detail {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  border-left: 1rpx solid var(--color-border);
}

.work-detail:first-child { padding-left: 0; border-left: 0; }
.work-detail:last-child { padding-right: 0; }
.detail-label { margin-bottom: 8rpx; color: var(--color-text-secondary); font-size: 20rpx; }
.detail-value { font-size: 24rpx; line-height: 1.5; word-break: break-all; }

.works-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
  padding: 72rpx 32rpx;
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid var(--color-warm-gold);
  border-radius: 8rpx;
  color: var(--color-primary);
  font-family: var(--font-family-title);
  font-size: 48rpx;
}

.empty-title { font-family: var(--font-family-title); font-size: 34rpx; }
.empty-description { margin-top: 16rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.9; }
.start-button { margin-top: 32rpx; padding: 8rpx 50rpx; }
.works-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx; }
.works-error-text { color: var(--color-text-secondary); font-size: 23rpx; }
.retry-button { flex-shrink: 0; margin: 0; padding: 4rpx 16rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 23rpx; }
.work-preview-pending{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#849298;font-size:23rpx;background:#edf1ef}
.work-image-retry{margin-top:16rpx;background:transparent;color:#315c72;font-size:22rpx;line-height:1.8;padding:0 14rpx}
.work-image-retry::after{border:0}
.work-creation-label{display:inline-block;margin:12rpx 0 4rpx;font-size:21rpx;color:#8b7753;letter-spacing:2rpx}
.work-ai-description{display:flex;flex-direction:column;gap:12rpx;margin-top:12rpx;color:#667c84;font-size:24rpx;line-height:1.7}
.work-ai-style{color:#315c72;font-size:26rpx}
.works-loading{color:#7b898d;font-size:24rpx;line-height:1.7}
.work-actions{display:flex;justify-content:flex-end;margin-top:16rpx;padding-top:8rpx;border-top:1rpx solid var(--color-border)}
.work-delete{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:100rpx;min-height:44px;padding:0 14rpx;color:#9a594c;font-size:24rpx;line-height:1.5}
.work-delete-busy{opacity:.5}
