.article-page {
  padding-top: 34rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 4%, rgba(183, 137, 85, 0.10), transparent 260rpx),
    var(--color-page);
}

.article-header {
  padding: 8rpx 8rpx 28rpx;
}

.article-category {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 22rpx;
  color: #81552f;
  background: #f2e2c8;
  border-radius: 999rpx;
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.article-title {
  margin-top: 22rpx;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.38;
  letter-spacing: 1rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
}

.article-hero {
  overflow: hidden;
  height: 420rpx;
  background: var(--color-primary-soft);
  border: 1rpx solid rgba(11, 65, 98, 0.12);
  border-radius: var(--radius-card-lg);
  box-shadow: var(--shadow-card);
}

.article-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.article-caption {
  padding: 14rpx 10rpx 0;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  line-height: 1.6;
}

.article-content {
  margin-top: 28rpx;
  padding: 34rpx 30rpx 36rpx;
  background: rgba(255, 252, 247, 0.92);
  border: 1rpx solid rgba(217, 205, 187, 0.82);
  border-radius: var(--radius-card-lg);
  box-shadow: 0 8rpx 24rpx rgba(42, 48, 47, 0.07);
}

.article-lead {
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.85;
}

.article-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 30rpx 0 26rpx;
}

.article-divider-line {
  width: 72rpx;
  height: 1rpx;
  background: rgba(183, 137, 85, 0.45);
}

.article-divider-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin: 0 14rpx;
  color: var(--color-cinnabar);
  border: 1rpx solid rgba(169, 75, 62, 0.45);
  border-radius: 50%;
  font-family: var(--font-family-title);
  font-size: 20rpx;
}

.article-paragraph {
  margin-top: 24rpx;
  color: var(--color-text-primary);
  font-size: 28rpx;
  line-height: 1.92;
  text-align: justify;
}

.article-paragraph:first-of-type {
  margin-top: 0;
}

@media (max-width: 350px) {
  .article-title {
    font-size: 40rpx;
  }

  .article-hero {
    height: 390rpx;
  }

  .article-content {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }
}
