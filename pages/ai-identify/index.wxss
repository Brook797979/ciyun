.identify-page{position:relative;min-height:100vh;box-sizing:border-box;overflow-x:hidden;color:#073c62;background:#fbf5e9;font-family:"Songti SC","STSong",serif}.paper{position:absolute;inset:0;width:100%;height:100%;opacity:.9;pointer-events:none}.ink-hero{position:relative;overflow:hidden}.hero-landscape{position:absolute;width:100%;height:100%;object-position:right center}.hero-wash{position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,246,236,.72),rgba(251,246,236,.08) 70%,rgba(251,246,236,.15))}.has-result .hero-wash{background:linear-gradient(90deg,rgba(251,246,236,.7),rgba(251,246,236,.15))}
