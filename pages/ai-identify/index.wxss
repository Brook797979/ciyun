.identify-content{position:relative;max-width:850rpx;margin:0 auto;padding:0 22rpx 28rpx;box-sizing:border-box}.panel{position:relative;border:1rpx solid #c99050;border-radius:22rpx;background:rgba(255,251,243,.95);box-shadow:0 4rpx 9rpx rgba(89,64,30,.13);overflow:hidden}.panel::after{content:"";position:absolute;inset:5rpx;border:1rpx solid rgba(218,178,129,.48);border-radius:17rpx;pointer-events:none}.corner{position:absolute;width:57rpx;height:57rpx;z-index:2;pointer-events:none}.top-left{top:1rpx;left:1rpx}.top-right{top:1rpx;right:1rpx;transform:rotate(90deg)}.bottom-left{bottom:1rpx;left:1rpx;transform:rotate(-90deg)}.bottom-right{bottom:1rpx;right:1rpx;transform:rotate(180deg)}.cloud{position:absolute;pointer-events:none;opacity:.65}.selection-cloud{right:-12rpx;top:3rpx;width:150rpx;height:100rpx}.panel-mountains{position:absolute;left:0;bottom:35rpx;width:100%;height:290rpx;opacity:.24;pointer-events:none}
.selection-panel{display:flex;flex-direction:column;align-items:center;padding:64rpx 24rpx 64rpx;min-height:628rpx;box-sizing:border-box}.camera-medallion{position:relative;display:flex;align-items:center;justify-content:center;width:246rpx;height:186rpx;margin:20rpx 0 35rpx;border:1rpx solid #d49f60;border-radius:44% 44% 40% 40%;background:linear-gradient(140deg,#fbf6ee,#eee4d5);box-shadow:0 0 0 9rpx rgba(253,247,237,.85),0 0 0 10rpx #d6a269}.medallion-line{position:absolute;left:34rpx;right:34rpx;top:-16rpx;bottom:-16rpx;border:1rpx solid #d6a269;border-radius:43%;background:linear-gradient(135deg,#fcf7ee,#eee4d7)}.camera-symbol{position:relative;z-index:1;width:108rpx;height:72rpx;border-radius:14rpx;background:linear-gradient(140deg,#316b94,#194b71);box-shadow:inset 0 2rpx 4rpx rgba(255,255,255,.3)}.camera-symbol::before{content:"";position:absolute;top:-12rpx;left:30rpx;width:48rpx;height:20rpx;background:#2d6289;border-radius:12rpx 12rpx 0 0}.camera-lens{position:absolute;left:34rpx;top:14rpx;width:35rpx;height:35rpx;border:6rpx solid #f8f6ef;border-radius:50%;box-shadow:inset 0 0 0 2rpx #95b3c7}.camera-dot{position:absolute;right:12rpx;top:11rpx;width:7rpx;height:7rpx;border-radius:50%;background:#fffaf2}.selection-title{position:relative;font-size:38rpx;font-weight:700;line-height:1.5}.selection-copy{position:relative;display:block;margin-top:8rpx;font-size:26rpx;line-height:1.6;text-align:center}.picker-actions{position:relative;display:flex;gap:20rpx;width:100%;margin-top:106rpx}.ornate-button{position:relative;display:flex;align-items:center;justify-content:center;gap:20rpx;box-sizing:border-box;height:86rpx;width:100%;margin:0;padding:0 24rpx;border:1rpx solid #c38a4a;border-radius:49rpx;box-shadow:0 3rpx 5rpx rgba(48,43,32,.16);font-family:inherit;font-size:29rpx;font-weight:600;line-height:1.3}.ornate-button::after{position:absolute;inset:4rpx;border:1rpx solid rgba(198,177,139,.8);border-radius:44rpx;pointer-events:none}.primary{background:linear-gradient(120deg,#376e94,#06446c 65%,#003751);color:#fffaf1}.secondary{background:linear-gradient(140deg,#fffdf7,#f4f2ec);color:#073c62}.secondary::after{border-color:#8ba9be}.picker-actions .ornate-button{flex:1;min-width:0;padding:0 14rpx;gap:18rpx}.ornate-button[disabled]{opacity:.6}.mini-camera{position:relative;width:38rpx;height:27rpx;border-radius:5rpx;background:currentColor;flex-shrink:0}.mini-camera::before{content:"";position:absolute;left:11rpx;top:-5rpx;width:17rpx;height:7rpx;border-radius:4rpx 4rpx 0 0;background:currentColor}.mini-camera::after{content:"";position:absolute;left:12rpx;top:7rpx;width:12rpx;height:12rpx;border:2rpx solid #17557e;border-radius:50%}.album-icon{position:relative;box-sizing:border-box;width:37rpx;height:33rpx;border:3rpx solid currentColor;border-radius:4rpx;overflow:hidden;flex-shrink:0}.album-icon::before{content:"";position:absolute;left:6rpx;top:5rpx;width:6rpx;height:6rpx;border-radius:50%;background:currentColor}.album-icon view{position:absolute;left:10rpx;top:15rpx;width:20rpx;height:20rpx;border:3rpx solid currentColor;transform:rotate(45deg)}
.with-photo{padding:24rpx 26rpx 30rpx;min-height:0}.chosen-image{position:relative;width:100%;height:340rpx;margin-bottom:18rpx;overflow:hidden;border-radius:15rpx;background:#e9e4d9}.chosen-image>image{display:block;width:100%;height:100%}.with-photo .selection-title{font-size:32rpx}.with-photo .selection-copy{font-size:24rpx}.selected-actions{position:relative;width:100%;margin-top:28rpx}.text-button{width:auto;margin:0;padding:8rpx 0;background:transparent;color:#285a78;font-family:inherit;font-size:24rpx;line-height:1.6}.selected-actions .text-button{margin:9rpx auto 0}.loading-note{position:relative;display:flex;align-items:center;gap:12rpx;margin-top:14rpx;color:#6d8391;font-size:23rpx}.loading-dot{width:10rpx;height:10rpx;background:#527da0;border-radius:50%;animation:breathe 1.5s ease-in-out infinite}@keyframes breathe{50%{opacity:.3}}
.result-panel{padding:20rpx 22rpx 28rpx}.result-overview{position:relative;z-index:1;display:flex;align-items:flex-start;gap:22rpx}.result-photo{position:relative;flex:0 0 42%;height:392rpx;overflow:hidden;border-radius:16rpx;background:#ded8cd;box-shadow:inset 0 0 0 1rpx rgba(9,43,62,.15)}.result-photo>image{width:100%;height:100%;display:block}.zoom{position:absolute;right:10rpx;bottom:12rpx;display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin:0;padding:0;border-radius:50%;background:rgba(12,23,26,.8)}.zoom-icon{position:relative;width:20rpx;height:20rpx;box-sizing:border-box;border:3rpx solid #fff;border-radius:50%;transform:translate(-2rpx,-2rpx)}.zoom-icon::after{content:"";position:absolute;width:12rpx;height:3rpx;background:#fff;right:-8rpx;bottom:-4rpx;transform:rotate(45deg)}.result-summary{flex:1;min-width:0;padding-top:12rpx}.result-badge{display:inline-block;padding:3rpx 17rpx;border:1rpx solid #d1a36e;border-radius:30rpx;background:linear-gradient(120deg,#d9ac74,#c88f58);color:#fffcf3;font-size:21rpx;line-height:1.5;letter-spacing:1rpx}.result-name{display:block;margin-top:13rpx;font-size:35rpx;font-weight:700;line-height:1.4;overflow-wrap:anywhere}.result-tags{display:flex;flex-wrap:wrap;gap:6rpx;margin-top:12rpx}.result-tags text{padding:3rpx 13rpx;border:1rpx solid #aec7d5;border-radius:25rpx;background:rgba(227,237,242,.65);font-size:21rpx;line-height:1.45}.feature-table{margin-top:17rpx;padding:13rpx 16rpx;border:1rpx solid #efdfcb;border-radius:13rpx;background:rgba(242,231,214,.7)}.feature-row{display:flex;align-items:flex-start;gap:12rpx;margin-top:8rpx;font-size:23rpx;line-height:1.5}.feature-row:first-child{margin-top:0}.feature-name{flex-shrink:0;width:53rpx;color:#7c7f78;letter-spacing:7rpx;white-space:nowrap}.feature-value{min-width:0;flex:1;overflow-wrap:anywhere}.uncertain-note{display:block;margin-top:18rpx;font-size:23rpx;line-height:1.6;color:#86705b}.result-cloud{right:-20rpx;top:362rpx;width:144rpx;height:96rpx;opacity:.45}.reading-section{position:relative;z-index:1;margin:23rpx 4rpx 0}.section-heading{display:flex;align-items:center;gap:15rpx;margin-bottom:8rpx;font-size:31rpx;font-weight:700;line-height:1.4}.section-heading image{width:34rpx;height:38rpx}.reading-copy,.evidence-copy{display:block;padding-left:16rpx;font-size:25rpx;line-height:1.75;letter-spacing:.3rpx;white-space:pre-wrap}.evidence-section{margin-top:18rpx}.evidence-copy+.evidence-copy{margin-top:3rpx}.record-icon{position:relative;flex-shrink:0;width:24rpx;height:30rpx;box-sizing:border-box;border:3rpx solid currentColor;border-radius:4rpx}.record-icon::before{content:"";position:absolute;left:5rpx;right:4rpx;top:6rpx;height:3rpx;background:currentColor;box-shadow:0 7rpx currentColor}.record-icon::after{content:"";position:absolute;left:-6rpx;top:4rpx;bottom:-6rpx;width:10rpx;border-left:3rpx solid currentColor;border-bottom:3rpx solid currentColor;border-radius:0 0 0 4rpx}.saved-note{display:block;margin:15rpx 0 0;text-align:center;color:#86918c;font-size:20rpx;line-height:1.5}.history-button{margin-top:20rpx;height:80rpx;gap:24rpx}.arrow{position:absolute;right:38rpx;font-family:sans-serif;font-size:43rpx;font-weight:400}.again-button{margin-top:15rpx;height:72rpx}.restart-icon{font-family:sans-serif;font-size:49rpx;font-weight:400;line-height:1}
.error-card{position:relative;display:flex;flex-direction:column;gap:9rpx;margin-top:18rpx;padding:22rpx;border:1rpx solid #dfc5a5;border-radius:15rpx;background:#fbf0df;font-size:24rpx;line-height:1.65;color:#795c3c}.error-title{font-weight:600;font-size:27rpx}.error-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:8rpx}.small-button{width:auto;margin:0;padding:10rpx 20rpx;border-radius:28rpx;background:#fffaf1;color:#285a78;font-family:inherit;font-size:23rpx;line-height:1.5}.status-note{position:relative;margin-top:16rpx;padding:8rpx 14rpx;color:#896c49;font-size:23rpx;line-height:1.65}.page-links{display:flex;align-items:center;justify-content:center;gap:24rpx;padding:20rpx 0 0;color:#a59780}.case-list{padding:28rpx}.case-heading{display:block;font-size:34rpx;font-weight:600}.case-note{display:block;margin:14rpx 0;color:#927655;font-size:22rpx;line-height:1.6}.case-item{display:flex;align-items:center;gap:20rpx;width:100%;margin:18rpx 0;padding:16rpx;border:1rpx solid #e0d3bf;border-radius:13rpx;color:#073c62;background:#fffaf2;font-family:inherit;font-size:28rpx;text-align:left;line-height:1.5}.case-item image{width:112rpx;height:126rpx;border-radius:10rpx;flex-shrink:0}.case-item>view{flex:1}.case-item text{display:block}.muted{margin-top:9rpx;color:#8a8a7f;font-size:22rpx}
