<view class="identify-page {{result ? 'has-result' : ''}}" style="padding-bottom:calc(126rpx + {{safeBottom}}px)">
  <image class="paper" src="{{media.paper}}" mode="aspectFill" aria-hidden="true"/>
  <view class="navigation-shell" style="height:{{navTop + navHeight + 6}}px"><view class="native-nav" style="top:{{navTop}}px;height:{{navHeight}}px"><view class="back-button" bindtap="goBack" hover-class="back-pressed" aria-role="button" aria-label="返回上一页或首页"><view class="back-chevron"/></view><text class="nav-title">AI识瓷</text></view></view>
  <view class="ink-hero" style="height:calc({{headerHeight}}px + {{result ? 182 : 344}}rpx)">
    <image class="hero-landscape" src="{{media.hero}}" mode="aspectFill" aria-hidden="true"/><view class="hero-wash"></view>
    <view class="brand" style="top:{{headerHeight - 6}}px"><view class="brand-row"><text class="brand-title">AI识瓷</text><text class="brand-seal">瓷韵</text></view><text class="brand-caption">一拍识瓷，探索千年陶瓷之美</text></view>
  </view>
  <view class="identify-content">
    <view wx:if="{{mode === 'showcase' && !selectedCase}}" class="panel case-list"><text class="case-heading">精选识瓷案例</text><text class="case-note">人工整理的展示示例，不是对当前图片的识别。</text><button wx:for="{{cases}}" wx:key="id" class="case-item" data-id="{{item.id}}" bindtap="selectCase"><image src="{{item.image}}" mode="aspectFill"/><view><text>{{item.name}}</text><text class="muted">预生成展示案例</text></view><text>›</text></button><button class="text-button" bindtap="returnToLive">返回实时识瓷</button></view>
    <view wx:elif="{{!result}}" class="panel selection-panel {{imagePath ? 'with-photo' : ''}}">
      <image class="corner top-left" src="/assets/icons/identify-corner.svg" aria-hidden="true"/><image class="corner top-right" src="/assets/icons/identify-corner.svg" aria-hidden="true"/><image class="corner bottom-left" src="/assets/icons/identify-corner.svg" aria-hidden="true"/><image class="corner bottom-right" src="/assets/icons/identify-corner.svg" aria-hidden="true"/>
      <image class="panel-mountains" src="{{media.hero}}" mode="aspectFill" aria-hidden="true"/><image class="cloud selection-cloud" src="/assets/icons/identify-cloud.svg" aria-hidden="true"/>
      <view wx:if="{{imagePath}}" class="chosen-image"><image src="{{imagePath}}" mode="aspectFit" bindtap="previewImage" aria-label="预览所选图片"/></view>
      <view wx:else class="camera-medallion"><view class="medallion-line"></view><view class="camera-symbol"><view class="camera-lens"/><view class="camera-dot"/></view></view>
      <text class="selection-title">{{imagePath ? '已选择瓷器图片' : '拍照识别陶瓷'}}</text><text class="selection-copy">{{imagePath ? '让瓷韵为你读懂器型、纹饰与釉色' : '支持拍照或从相册上传陶瓷图片'}}</text>
      <view wx:if="{{!imagePath}}" class="picker-actions"><button class="ornate-button primary" bindtap="chooseCamera"><view class="mini-camera"/>拍照</button><button class="ornate-button secondary" bindtap="chooseAlbum"><view class="album-icon"><view/></view>从相册选择</button></view>
      <view wx:else class="selected-actions"><button class="ornate-button primary" bindtap="startIdentify" loading="{{busy}}" disabled="{{busy || status === 'running' || status === 'unknown'}}">{{status === 'uploading' ? '正在上传图片' : status === 'running' ? '正在识别…' : status === 'unknown' ? '结果待确认' : status === 'failed' ? '重新尝试识别' : '开始识别'}}</button><button class="text-button" bindtap="choose" disabled="{{busy}}">重新选择图片</button></view>
      <view wx:if="{{busy || status === 'running'}}" class="loading-note"><view class="loading-dot"/>正在观察器型、纹饰与釉色，请稍候</view>
    </view>
    <view wx:else class="panel result-panel">
      <image class="corner top-left" src="/assets/icons/identify-corner.svg" aria-hidden="true"/><image class="corner top-right" src="/assets/icons/identify-corner.svg" aria-hidden="true"/>
      <view class="result-overview"><view class="result-photo"><image src="{{imagePath}}" mode="aspectFit" bindtap="previewImage" aria-label="预览识别图片"/></view><view class="result-summary"><text class="result-badge">{{mode === 'showcase' ? '整理展示案例' : fromHistory ? '历史识别结果' : 'AI识别结果'}}</text><text class="result-name">{{resultName}}</text><view wx:if="{{resultTags.length && result.status !== 'not_ceramic'}}" class="result-tags"><text wx:for="{{resultTags}}" wx:key="*this">{{item}}</text></view><view wx:if="{{result.status !== 'not_ceramic'}}" class="feature-table"><view wx:for="{{featureCards}}" wx:key="name" class="feature-row"><text class="feature-name">{{item.name}}</text><text class="feature-value">{{item.value}}</text></view></view><text wx:if="{{result.status !== 'recognized'}}" class="uncertain-note">{{result.status === 'not_ceramic' ? '请换一张器物轮廓完整的陶瓷照片。' : '当前图片线索有限，可补拍清晰细节。'}}</text></view></view>
      <image class="cloud result-cloud" src="/assets/icons/identify-cloud.svg" aria-hidden="true"/>
      <view wx:if="{{result.cultureIntro}}" class="reading-section"><view class="section-heading"><image src="/assets/icons/tab-museum-active.png" mode="aspectFit"/><text>文化介绍</text></view><text class="reading-copy">{{result.cultureIntro}}</text></view>
      <view wx:if="{{result.observations.length}}" class="reading-section evidence-section"><view class="section-heading"><view class="record-icon"/><text>识别依据</text></view><text class="evidence-copy" wx:for="{{result.observations}}" wx:key="*this">{{item}}</text></view>
      <text wx:if="{{mode === 'live' && historySaved && !fromHistory}}" class="saved-note">本次图片与识别结果已自动保存</text><text wx:if="{{mode === 'showcase'}}" class="case-note">{{caseLabel}} · 不计入真实识别记录</text>
      <button class="ornate-button primary history-button" bindtap="openHistory"><view class="record-icon"/>查看识别记录<text class="arrow">›</text></button><button wx:if="{{mode === 'live'}}" class="ornate-button secondary again-button" bindtap="returnToIdentify"><text class="restart-icon">‹</text>返回识瓷</button><button wx:else class="ornate-button secondary again-button" bindtap="returnToLive">返回实时识瓷</button>
    </view>
    <view wx:if="{{mode === 'live' && error}}" class="error-card"><text class="error-title">{{status === 'unknown' ? '识别结果待确认' : '暂时未能完成识别'}}</text><text>{{error}}</text><view class="error-actions"><button wx:if="{{canRetry}}" class="small-button" bindtap="retry" disabled="{{busy}}">{{assetId ? '查询原请求' : '重新尝试'}}</button><button wx:if="{{assetId && status === 'failed'}}" class="small-button" bindtap="restart" disabled="{{busy}}">再次识别当前图片</button><button wx:if="{{fromHistory}}" class="small-button" bindtap="openHistory">返回识别记录</button></view></view>
    <view wx:if="{{imageWarning}}" class="status-note">{{imageWarning}}<button class="text-button" bindtap="refreshImage">重新加载图片</button></view><view wx:if="{{storageWarning}}" class="status-note">{{storageWarning}}</view>
    <view wx:if="{{!result && mode === 'live'}}" class="page-links"><button class="text-button" bindtap="openHistory">识别记录 ›</button></view>
  </view><porcelain-tabbar selected="workshop" safe-bottom="{{safeBottom}}"/>
</view>
