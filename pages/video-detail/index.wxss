.video-detail-page { padding-top: 28rpx; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.detail-media { overflow: hidden; background: var(--color-primary-soft); border-radius: var(--radius-card-lg); box-shadow: var(--shadow-card); }
.detail-video, .detail-poster { display: block; width: 100%; height: 400rpx; }
.detail-poster { position: relative; overflow: hidden; }
.detail-cover, .detail-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.detail-shade { background: linear-gradient(180deg, transparent, rgba(7, 24, 33, 0.42)); }
.detail-play { position: absolute; top: 50%; left: 50%; display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; background: rgba(255, 252, 247, 0.9); border-radius: 50%; transform: translate(-50%, -50%); }
.detail-triangle { width: 0; height: 0; margin-left: 7rpx; border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-left: 19rpx solid var(--color-primary); }
.detail-duration { position: absolute; right: 18rpx; bottom: 16rpx; padding: 5rpx 14rpx; color: #fff; background: rgba(0, 0, 0, 0.62); border-radius: 999rpx; font-size: 22rpx; }
.detail-content { margin-top: 26rpx; padding: 30rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: var(--radius-card-lg); box-shadow: 0 8rpx 22rpx rgba(42, 48, 47, 0.07); }
.detail-label { display: inline-flex; padding: 6rpx 18rpx; color: #81552f; background: #f5e7d0; border-radius: 999rpx; font-size: 21rpx; }
.detail-title { margin-top: 18rpx; color: var(--color-ink-blue); font-family: var(--font-family-title); font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.detail-description { margin-top: 14rpx; color: var(--color-text-secondary); font-size: 27rpx; line-height: 1.7; }
.detail-pending { margin-top: 26rpx; padding-top: 22rpx; color: var(--color-text-tertiary); border-top: 1rpx solid var(--color-border); font-size: 22rpx; }
