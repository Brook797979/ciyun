page { height:100%; overflow:hidden; background:#f7f1e7; }
.chat-page { position:fixed; top:0; right:0; bottom:0; left:0; display:flex; flex-direction:column; width:100%; height:auto; overflow:hidden; background:#f7f1e7; color:#172c40; font-family:"PingFang SC","Microsoft YaHei",sans-serif; }
.chat-page button { box-sizing:border-box; }
.page-paper { position:absolute; inset:0; width:100%; height:100%; opacity:.68; pointer-events:none; }
.native-header { position:relative; flex:0 0 auto; overflow:hidden; }
.header-landscape { position:absolute; inset:0; width:100%; height:100%; transform:scaleX(-1); pointer-events:none; }
.header-wash { position:absolute; inset:0; background:linear-gradient(180deg,rgba(247,241,231,.13) 25%,rgba(247,241,231,.05) 55%,#f7f1e7 100%); pointer-events:none; }
.native-nav { position:absolute; left:0; right:0; display:flex; align-items:center; }
.chat-page button.back-button { position:absolute; left:12px; top:50%; z-index:3; display:flex; align-items:center; justify-content:center; flex:0 0 34px; width:34px; min-width:34px; max-width:34px; height:34px; min-height:34px; max-height:34px; margin:0; padding:0; border:0; border-radius:50%; background:rgba(255,253,248,.76); font-size:0; line-height:34px; transform:translateY(-50%); overflow:hidden; }
.back-button image { display:block; flex:0 0 18px; width:18px; height:18px; }
.hero-copy { position:absolute; left:100rpx; right:100rpx; text-align:center; color:#103f65; }
.hero-title { font-family:"Songti SC","STSong","SimSun",serif; font-size:54rpx; font-weight:600; letter-spacing:3rpx; line-height:1.35; text-shadow:0 1rpx 5rpx rgba(255,253,248,.8); white-space:nowrap; }
.hero-subtitle { display:flex; justify-content:center; align-items:center; gap:12rpx; margin-top:7rpx; font-family:"Songti SC","STSong","SimSun",serif; font-size:25rpx; letter-spacing:3rpx; line-height:1.5; white-space:nowrap; }
.subtitle-rule { height:1rpx; width:24rpx; flex-shrink:0; background:#93a8b2; }
.chat-page button.history-button { position:absolute; left:auto; right:12px; bottom:auto; z-index:4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; flex:0 0 44px; width:44px; min-width:44px; max-width:44px; height:48px; min-height:48px; max-height:48px; margin:0; padding:3px 0; border:0; border-radius:6px; background:rgba(255,253,248,.66); color:#103f65; font-size:10px; font-weight:400; line-height:14px; letter-spacing:0; overflow:hidden; }
.history-button image { display:block; flex:0 0 22px; width:22px; height:22px; }
.chat-scroll { position:relative; flex:1 1 0%; width:100%; height:0; min-height:0; box-sizing:border-box; }
.chat-content { padding:0 28rpx 28rpx; box-sizing:border-box; }
.context-card { display:flex; align-items:center; gap:16rpx; margin:4rpx 0 24rpx; padding:14rpx 18rpx; border:1rpx solid #ddc8aa; border-radius:18rpx; background:rgba(255,253,248,.82); }
.context-card image { flex-shrink:0; width:70rpx; height:76rpx; border-radius:10rpx; }
.context-copy { flex:1; min-width:0; }
.context-label { color:#829097; font-size:20rpx; line-height:1.6; }
.context-name { margin-top:3rpx; color:#103f65; font-size:25rpx; line-height:1.5; word-break:break-all; }
.context-seal { flex-shrink:0; border:1rpx solid #c6a781; padding:5rpx 4rpx; writing-mode:vertical-rl; color:#9f7f56; font-family:"Songti SC","STSong",serif; font-size:21rpx; line-height:1.2; }
.welcome-section { padding:0 0 30rpx; }
.welcome-row { display:flex; align-items:center; margin:-6rpx -2rpx 28rpx; gap:9rpx; }
.welcome-robot { position:relative; flex-shrink:0; width:165rpx; height:184rpx; }
.welcome-bubble { position:relative; flex:1; min-width:0; padding:26rpx 23rpx; border:1rpx solid #ddc8aa; border-radius:25rpx; background:rgba(255,253,249,.86); box-shadow:0 4rpx 10rpx rgba(87,70,42,.05); }
.welcome-bubble::before { position:absolute; left:-11rpx; top:42%; width:19rpx; height:19rpx; content:""; background:#fffdf9; border-left:1rpx solid #ddc8aa; border-bottom:1rpx solid #ddc8aa; transform:rotate(45deg); }
.welcome-title,.welcome-copy { position:relative; z-index:1; font-family:"Songti SC","STSong","SimSun",serif; font-size:27rpx; line-height:1.8; word-break:break-all; }
.welcome-cloud { position:absolute; right:6rpx; bottom:-8rpx; z-index:0; color:#e9e2d5; font-size:96rpx; line-height:1; opacity:.65; }
.questions-heading { display:flex; align-items:center; gap:12rpx; margin:0 6rpx 20rpx; color:#103f65; font-family:"Songti SC","STSong","SimSun",serif; font-size:27rpx; font-weight:600; letter-spacing:2rpx; }
.heading-flower { font-size:39rpx; line-height:1; color:#577d9e; }
.heading-rule { flex:1; height:1rpx; margin-left:9rpx; background:linear-gradient(90deg,#7f9ab0,rgba(127,154,176,0)); }
.quick-questions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14rpx; }
.quick-question { display:flex; align-items:center; gap:10rpx; width:100%; min-height:118rpx; margin:0; padding:17rpx 13rpx; border:1rpx solid #ddc8aa; border-radius:23rpx; background:rgba(255,253,248,.81); box-shadow:0 4rpx 7rpx rgba(69,63,47,.07),inset 0 0 0 3rpx rgba(255,255,255,.64); color:#103f65; font-family:"Songti SC","STSong","SimSun",serif; text-align:left; line-height:1.55; }
.question-icon { flex-shrink:0; width:49rpx; height:61rpx; }
.question-label { flex:1; min-width:0; font-size:24rpx; word-break:break-all; }
.question-chevron { flex-shrink:0; font-family:Arial,sans-serif; font-size:33rpx; font-weight:300; line-height:1; }
.welcome-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6rpx 14rpx; margin:16rpx 6rpx 0; color:#9c9b94; font-size:19rpx; line-height:1.7; }
.text-button { margin:0; padding:8rpx 0; background:transparent; color:#476c86; font-size:23rpx; line-height:1.5; white-space:nowrap; }
.messages { display:flex; flex-direction:column; gap:24rpx; }
.message-time { margin:9rpx 0 23rpx; color:#989c9a; font-size:21rpx; line-height:1.5; text-align:center; }
.message-row { display:flex; align-items:flex-start; gap:13rpx; width:100%; }
.message-row.user { flex-direction:row-reverse; }
.message-avatar { display:block; flex-shrink:0; width:62rpx; height:65rpx; margin-top:2rpx; border-radius:50%; box-sizing:border-box; }
.robot-avatar { border:2rpx solid rgba(255,255,255,.9); background:rgba(255,253,248,.78); }
.user-avatar { position:relative; width:56rpx; height:56rpx; margin-top:3rpx; background:#d7e8fa; overflow:hidden; }
.avatar-head { position:absolute; left:20rpx; top:10rpx; width:17rpx; height:18rpx; border-radius:50%; background:#6489ad; }
.avatar-shoulders { position:absolute; left:12rpx; bottom:9rpx; width:33rpx; height:18rpx; border-radius:22rpx 22rpx 5rpx 5rpx; background:#6489ad; }
.bubble { position:relative; box-sizing:border-box; min-width:0; max-width:calc(100% - 78rpx); padding:22rpx 24rpx; border-radius:25rpx; }
.bubble.assistant { border:1rpx solid rgba(220,213,200,.76); border-top-left-radius:13rpx; background:rgba(255,253,249,.94); box-shadow:0 4rpx 10rpx rgba(76,68,48,.025); }
.bubble.user { max-width:calc(100% - 100rpx); border:1rpx solid rgba(181,210,239,.42); border-top-right-radius:11rpx; background:#d7e8fa; color:#173e60; }
.message-text { min-width:0; font-size:28rpx; line-height:1.85; white-space:pre-wrap; word-break:break-all; }
.message-sources { display:flex; flex-direction:column; gap:18rpx; margin-top:16rpx; }
.source-card { min-width:0; overflow:hidden; border:1rpx solid #e9e2d7; border-radius:15rpx; background:#fbf8f2; }
.source-image { display:block; width:100%; height:174rpx; }
.source-link { display:flex; align-items:center; gap:9rpx; width:100%; margin:0; padding:13rpx 12rpx; color:#365d7a; background:transparent; line-height:1.5; text-align:left; }
.source-kind { flex-shrink:0; color:#8b948e; font-size:18rpx; }
.source-name { flex:1; min-width:0; font-size:21rpx; word-break:break-all; }
.source-chevron { flex-shrink:0; font-size:28rpx; line-height:1; }
.pending-item { margin-top:5rpx; }
.waiting-row { margin-top:0; }
.waiting-bubble { min-width:280rpx; }
.waiting-copy { display:flex; align-items:center; gap:12rpx; color:#355b76; font-size:25rpx; line-height:1.6; }
.waiting-dots { display:flex; align-items:center; gap:6rpx; }
.waiting-dots text { width:6rpx; height:6rpx; border-radius:50%; background:#6b8ca4; opacity:.4; animation:porcelain-breath 1.8s ease-in-out infinite; }
.waiting-dots text:nth-child(2) { animation-delay:.2s; }
.waiting-dots text:nth-child(3) { animation-delay:.4s; }
.waiting-hint { margin-top:7rpx; color:#95a0a2; font-size:20rpx; line-height:1.6; }
.error-card { margin:26rpx 0 0 74rpx; padding:22rpx 24rpx; border:1rpx solid #dfcfb8; border-radius:20rpx; background:rgba(247,237,222,.94); color:#775c3e; }
.error-title { margin-bottom:8rpx; font-size:25rpx; font-weight:600; line-height:1.6; }
.error-copy { font-size:23rpx; line-height:1.8; word-break:break-all; }
.error-actions { display:flex; align-items:center; flex-wrap:wrap; gap:14rpx; margin-top:18rpx; }
.small-button { margin:0; padding:11rpx 21rpx; border:1rpx solid #486c85; border-radius:12rpx; background:#486c85; color:#fffdf8; font-size:22rpx; line-height:1.5; }
.small-button-outline { background:transparent; color:#486c85; }
.error-actions .text-button { font-size:21rpx; }
.storage-warning { margin:20rpx 4rpx 0; padding:15rpx 18rpx; border-radius:12rpx; color:#8f7455; background:rgba(238,225,203,.75); font-size:21rpx; line-height:1.7; word-break:break-all; }
.scroll-anchor { width:1rpx; height:1rpx; }
.composer { position:fixed; left:0; right:0; z-index:20; display:flex; align-items:flex-end; gap:15rpx; padding:8px 24rpx; border-top:1rpx solid rgba(221,211,195,.72); box-sizing:border-box; background:rgba(248,244,236,.98); box-shadow:0 -6rpx 25rpx rgba(120,106,79,.025); }
.input-shell { display:flex; align-items:center; flex:1; min-width:0; min-height:47px; box-sizing:border-box; padding:4px 23rpx; border:1rpx solid #e2dbd1; border-radius:30px; background:#fffdfa; }
.question-input { display:block; box-sizing:border-box; width:100%; min-height:21px; max-height:70px; padding:0; color:#172c40; font-size:27rpx; line-height:21px; word-break:break-all; }
.input-placeholder { color:#aaa9a3; font-size:27rpx; }
.chat-page button.send-button { position:relative; order:2; display:flex; align-items:center; align-self:center; justify-content:center; flex:0 0 40px; width:40px; min-width:40px; max-width:40px; height:40px; min-height:40px; max-height:40px; margin:0; padding:0; border:0; border-radius:50%; color:white; background:linear-gradient(145deg,#6288aa,#123f64); font-size:0; line-height:40px; overflow:hidden; }
.send-button image { display:block; flex:0 0 20px; width:20px; height:20px; margin:0 0 0 -1px; }
.chat-page button.send-button[disabled] { color:#fff; background:linear-gradient(145deg,#9db4c5,#6686a0); opacity:.72; }
.quick-question[disabled],.text-button[disabled] { color:#8292a0; opacity:.6; background:rgba(255,253,248,.5); }
.showcase-section { padding:0 0 25rpx; }
.showcase-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:3rpx 4rpx 24rpx; }
.section-caption { color:#87969b; font-size:20rpx; letter-spacing:2rpx; line-height:1.6; }
.section-title { margin-top:5rpx; color:#103f65; font-family:"Songti SC","STSong","SimSun",serif; font-size:36rpx; font-weight:600; letter-spacing:2rpx; line-height:1.5; }
.case-note { display:flex; align-items:flex-start; gap:12rpx; margin-bottom:22rpx; padding:18rpx 20rpx; border-radius:16rpx; background:rgba(237,225,204,.8); color:#88714d; font-size:22rpx; line-height:1.75; }
.case-note-label { flex-shrink:0; border:1rpx solid #c6aa80; border-radius:4rpx; padding:1rpx 6rpx; font-size:19rpx; }
.case-item { width:100%; margin:0 0 16rpx; padding:24rpx; border:1rpx solid #e1d4c1; border-radius:20rpx; background:rgba(255,253,249,.9); text-align:left; }
.case-item-selected { border-color:#8fa9b8; background:#f3f6f5; }
.case-question { color:#234a66; font-size:27rpx; line-height:1.7; word-break:break-all; }
.case-meta { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:12rpx; color:#989588; font-size:20rpx; line-height:1.6; }
.sample-conversation { display:flex; flex-direction:column; gap:22rpx; margin-top:30rpx; }
.sample-label,.sample-footnote { color:#968064; font-size:21rpx; text-align:center; line-height:1.7; }
.sample-footnote { font-size:20rpx; }
.history-overlay { position:fixed; inset:0; z-index:100; }
.history-scrim { position:absolute; inset:0; background:rgba(25,44,54,.32); }
.history-sheet { position:absolute; top:0; right:0; bottom:0; display:flex; flex-direction:column; width:650rpx; max-width:88%; box-sizing:border-box; padding-left:28rpx; padding-right:28rpx; background:#f9f5ed; box-shadow:-10rpx 0 40rpx rgba(23,44,64,.08); }
.history-heading { display:flex; align-items:center; justify-content:space-between; gap:18rpx; padding:22rpx 0 27rpx; }
.chat-page button.history-close { display:flex; align-items:center; justify-content:center; flex:0 0 32px; width:32px; min-width:32px; max-width:32px; height:32px; min-height:32px; max-height:32px; margin:0; padding:0; border:0; border-radius:50%; background:#f0eade; color:#6d8390; font-size:23px; font-weight:300; line-height:32px; overflow:hidden; }
.new-conversation { display:flex; align-items:center; justify-content:center; gap:14rpx; flex-shrink:0; width:100%; margin:0 0 24rpx; padding:18rpx; border:1rpx solid #b6c4c9; border-radius:16rpx; background:#ecf1f0; color:#244f6d; font-size:26rpx; line-height:1.5; }
.new-conversation-mark { font-size:33rpx; line-height:1; }
.history-status { flex-shrink:0; margin:-6rpx 0 20rpx; padding:13rpx 16rpx; border-radius:12rpx; background:#f0e6d4; color:#92734a; font-size:21rpx; line-height:1.7; }
.history-list { flex:1; height:0; min-height:0; width:100%; }
.history-item { width:100%; margin:0 0 15rpx; padding:23rpx 21rpx; border:1rpx solid #e4dccc; border-radius:17rpx; background:#fffdf9; color:#2c4c63; text-align:left; }
.history-item-current { border-color:#9ab2c2; background:#eef3f4; }
.history-item-top { display:flex; align-items:flex-start; gap:12rpx; }
.history-item-title { display:-webkit-box; flex:1; min-width:0; overflow:hidden; -webkit-line-clamp:2; -webkit-box-orient:vertical; font-size:26rpx; line-height:1.65; word-break:break-all; }
.history-current-label { flex-shrink:0; margin-top:4rpx; border-radius:6rpx; padding:3rpx 8rpx; background:#dde8ec; color:#5e8095; font-size:18rpx; line-height:1.4; }
.history-preview { display:-webkit-box; overflow:hidden; -webkit-line-clamp:2; -webkit-box-orient:vertical; margin-top:10rpx; color:#8b9698; font-size:22rpx; line-height:1.7; word-break:break-all; }
.history-meta { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8rpx; margin-top:14rpx; color:#9a9c96; font-size:19rpx; line-height:1.5; }
.history-active-label { color:#9c7a4e; }
.history-ceramic { display:inline-block; max-width:100%; margin-top:12rpx; border-bottom:1rpx solid #d7dfdc; color:#6e8c99; font-size:20rpx; line-height:1.7; word-break:break-all; }
.history-item[disabled] { opacity:.65; color:#7e8e98; }
.new-conversation[disabled] { background:#e6e8e4; color:#a0aaa9; border-color:#d0d7d2; }
.history-empty { padding:80rpx 10rpx; color:#728a98; font-size:26rpx; text-align:center; line-height:1.8; }
.history-empty-mark { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin:0 auto 22rpx; border:1rpx solid #c9b08c; color:#9b7d53; font-family:"Songti SC","STSong",serif; font-size:39rpx; line-height:1; }
.history-empty > text:last-child { color:#a1a49d; font-size:22rpx; }
.history-list-end { height:12rpx; }
.history-local-note { flex-shrink:0; padding:18rpx 0 0; color:#a1a49c; font-size:20rpx; line-height:1.7; text-align:center; }
/* Native v2 buttons apply 184px to non-mini sizes; scope compact and full-width controls separately. */
.chat-page button.quick-question,.chat-page button.history-item,.chat-page button.new-conversation,.chat-page button.source-link,.chat-page button.case-item { width:100%; min-width:0; max-width:100%; font-weight:400; }
.chat-page button.small-button,.chat-page button.text-button { width:auto; min-width:0; max-width:100%; font-weight:400; }
.chat-page button.back-button::after,.chat-page button.history-button::after,.chat-page button.send-button::after,.chat-page button.history-close::after { border:0; }
.chat-page button.send-button[loading]::before { flex:0 0 18px; width:18px; height:18px; margin:0; }
@keyframes porcelain-breath { 0%,100% { opacity:.35; } 50% { opacity:1; } }
@media(max-width:350px) { .hero-title { font-size:50rpx; letter-spacing:2rpx; } .hero-copy { left:96rpx; right:96rpx; } .hero-subtitle { font-size:24rpx; letter-spacing:1rpx; gap:9rpx; } .chat-content { padding-left:23rpx; padding-right:23rpx; } .welcome-robot { width:148rpx; height:174rpx; } .welcome-bubble { padding:20rpx 21rpx; } .welcome-title,.welcome-copy { font-size:26rpx; } .quick-question { gap:8rpx; padding:15rpx 11rpx; } .question-icon { width:44rpx; } .question-label { font-size:24rpx; } .bubble { padding:21rpx; } .message-text { font-size:28rpx; } .error-card { margin-left:0; } .history-sheet { padding-left:24rpx; padding-right:24rpx; } }
@media(prefers-reduced-motion:reduce) { .waiting-dots text { animation:none; opacity:.65; } }
