.history-page { position: relative; box-sizing: border-box; min-height: 100vh; overflow-x: hidden; color: #102e43; background: #fbf6ec; font-family: "Songti SC", "STSong", serif; }
.history-paper { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .32; pointer-events: none; }
.history-hero { position: relative; overflow: hidden; }
.history-ink, .history-wash { position: absolute; inset: 0; width: 100%; height: 100%; }
.history-ink { opacity: .7; }
.history-wash { background: linear-gradient(90deg, rgba(251, 246, 236, .2), rgba(251, 246, 236, .04)), linear-gradient(180deg, rgba(251, 246, 236, .04) 55%, #fbf6ec); }
.history-nav { position: absolute; z-index: 2; left: 28rpx; right: 28rpx; }
.history-back { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 100%; min-height: 44rpx; }
.history-back-chevron { width: 20rpx; height: 20rpx; border-left: 3rpx solid #063d65; border-bottom: 3rpx solid #063d65; transform: rotate(45deg); }
.history-brand { position: absolute; left: 50rpx; right: 32rpx; z-index: 1; }
.history-brand-row { display: flex; align-items: center; gap: 16rpx; }
.history-title { color: #063d65; font-family: "STKaiti", "KaiTi", serif; font-size: 76rpx; font-weight: 700; line-height: 1.15; letter-spacing: 6rpx; text-shadow: 0 2rpx 2rpx rgba(255, 252, 247, .8); }
.history-seal { box-sizing: border-box; width: 28rpx; padding: 8rpx 5rpx; border-radius: 5rpx; color: #fff8eb; background: #a94b3e; font-size: 18rpx; line-height: 1.1; text-align: center; }
.history-subtitle { display: block; margin-top: 18rpx; color: #315b71; font-size: 25rpx; line-height: 1.6; letter-spacing: 3rpx; }
.history-content { position: relative; z-index: 1; margin-top: -20rpx; padding: 0 28rpx 24rpx; }
.history-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 0 4rpx 22rpx; color: #063d65; font-size: 28rpx; }
.history-local-note { color: #73858a; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 20rpx; }
.history-image-progress { display: block; margin: -8rpx 4rpx 18rpx; color: #74858b; font-size: 23rpx; }
.history-card { display: flex; gap: 24rpx; box-sizing: border-box; margin-bottom: 24rpx; padding: 16rpx; border: 1rpx solid rgba(201, 144, 80, .62); border-radius: 16rpx; background: rgba(255, 252, 247, .85); box-shadow: 0 4rpx 14rpx rgba(47, 67, 75, .04); }
.history-image-frame { flex-shrink: 0; width: 188rpx; height: 230rpx; overflow: hidden; border: 1rpx solid #d9e5e9; border-radius: 9rpx; background: #eaf0ef; }
.history-image { display: block; width: 100%; height: 100%; min-height: 222rpx; }
.history-image-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; height: 100%; min-height: 222rpx; padding: 14rpx 6rpx; color: #718994; }
.history-image-mark { margin-bottom: 10rpx; color: #a7bdc3; font-family: "STKaiti", "KaiTi", serif; font-size: 56rpx; }
.history-image-message { font-size: 21rpx; text-align: center; }
.history-image-retry { margin: 8rpx 0 0; padding: 0 12rpx; min-height: 46rpx; color: #063d65; background: transparent; font-size: 23rpx; line-height: 46rpx; }
.history-card-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 4rpx 4rpx 0 0; }
.history-record-title { color: #063d65; font-size: 34rpx; font-weight: 700; line-height: 1.45; overflow-wrap: break-word; }
.history-tags { display: flex; flex-wrap: wrap; gap: 7rpx; margin-top: 9rpx; }
.history-tag { max-width: 100%; padding: 3rpx 10rpx; border: 1rpx solid #d0dedf; border-radius: 4rpx; color: #446a7c; background: #eff3f1; font-size: 20rpx; line-height: 1.45; overflow-wrap: break-word; }
.history-summary { display: -webkit-box; margin-top: 9rpx; overflow: hidden; color: #667c86; font-size: 24rpx; line-height: 1.65; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: break-word; }
.history-card-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 14rpx; margin-top: auto; padding-top: 14rpx; color: #8b9696; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 19rpx; line-height: 1.6; }
.history-status { color: #567b8a; }
.history-status-muted { color: #947c5f; }
.history-card-actions { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 8rpx; }
.history-delete { flex-shrink: 0; min-width: 112rpx; height: 52rpx; margin: 0; padding: 0 12rpx; border: 1rpx solid rgba(201, 144, 80, .42); border-radius: 7rpx; color: #8c6c56; background: transparent; font-family: "Songti SC", "STSong", serif; font-size: 22rpx; line-height: 50rpx; }
.history-delete[disabled] { color: #a79888; background: transparent; opacity: .65; }
.history-delete-error { margin: -5rpx 0 20rpx; padding: 15rpx 18rpx; border-left: 3rpx solid #c99050; color: #946344; background: #f4ebdd; font-size: 24rpx; line-height: 1.6; }
.history-open { color: #063d65; font-size: 23rpx; line-height: 1.5; }
.history-open text { margin-left: 5rpx; font-family: sans-serif; font-size: 29rpx; }
.history-endnote { display: block; margin: 32rpx 0 12rpx; color: #8a9696; font-size: 23rpx; line-height: 1.6; text-align: center; }
.history-state { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; margin: 12rpx 0 32rpx; padding: 64rpx 30rpx 58rpx; border: 1rpx solid rgba(201, 144, 80, .45); border-radius: 18rpx; background: rgba(255, 252, 247, .7); text-align: center; }
.history-state-title { color: #063d65; font-size: 34rpx; font-weight: 700; line-height: 1.6; }
.history-state-copy { margin-top: 16rpx; color: #73838b; font-size: 25rpx; line-height: 1.8; }
.history-action { position: relative; box-sizing: border-box; min-width: 300rpx; max-width: 100%; min-height: 78rpx; margin: 36rpx 0 0; padding: 0 40rpx; border: 1rpx solid #c99050; border-radius: 44rpx; color: #fff8eb; background: #063d65; font-family: "Songti SC", "STSong", serif; font-size: 29rpx; line-height: 78rpx; letter-spacing: 3rpx; }
.history-action::before { position: absolute; inset: 5rpx; border: 1rpx solid rgba(229, 194, 141, .58); border-radius: 40rpx; content: ""; pointer-events: none; }
.history-empty-vessel { position: relative; width: 86rpx; height: 88rpx; margin: 0 0 36rpx; border: 3rpx solid #bacbd0; border-top: 0; border-radius: 10rpx 10rpx 40rpx 40rpx; background: linear-gradient(180deg, transparent 48%, rgba(217, 229, 233, .6)); }
.history-empty-vessel::before { position: absolute; top: -8rpx; left: -4rpx; right: -4rpx; height: 12rpx; border: 2rpx solid #a8bec7; border-radius: 50%; content: ""; }
.history-vessel-line { position: absolute; top: 30rpx; left: 4rpx; right: 4rpx; height: 12rpx; border-top: 2rpx solid #bdcfd3; border-bottom: 2rpx solid #bdcfd3; border-radius: 50%; }
.history-pressed, .history-card-pressed { opacity: .8; }
@media (max-width: 350px) { .history-card { gap: 18rpx; padding: 13rpx; } .history-image-frame { width: 174rpx; } .history-record-title { font-size: 32rpx; } .history-local-note { font-size: 19rpx; } }
