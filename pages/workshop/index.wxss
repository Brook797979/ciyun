.workshop-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--color-ink-blue);
  background: var(--color-page);
}

.workshop-paper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.22;
  pointer-events: none;
}

.workshop-viewport-probe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  visibility: hidden;
  pointer-events: none;
}

.workshop-hero {
  position: relative;
  z-index: 1;
  flex: none;
  overflow: hidden;
  background: var(--color-silk);
}

.workshop-hero-image,
.workshop-hero-wash,
.entry-image,
.entry-wash {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.workshop-hero-wash {
  background:
    linear-gradient(90deg, rgba(248, 241, 230, 0.26), rgba(248, 241, 230, 0.04) 62%, transparent 82%),
    linear-gradient(180deg, transparent 67%, rgba(248, 241, 230, 0.96));
}

.workshop-brand {
  position: absolute;
  z-index: 2;
  left: 36rpx;
}

.workshop-brand-row {
  display: flex;
  align-items: center;
  gap: 13rpx;
}

.workshop-brand-title {
  color: var(--color-ink-blue);
  font-family: "STKaiti", "KaiTi", var(--font-family-title);
  font-size: 90rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 2rpx rgba(255, 252, 247, 0.72);
}

.workshop-brand-seal {
  box-sizing: border-box;
  width: 30rpx;
  padding: 7rpx 5rpx;
  color: #fff8eb;
  background: var(--color-cinnabar);
  border-radius: 6rpx;
  font-family: var(--font-family-title);
  font-size: 15rpx;
  line-height: 1.05;
  letter-spacing: 1rpx;
  text-align: center;
}

.workshop-brand-subtitle {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  color: rgba(7, 57, 88, 0.91);
  font-family: var(--font-family-title);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.45;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.workshop-brand-subtitle::before {
  flex: none;
  width: 7rpx;
  height: 7rpx;
  margin-right: 14rpx;
  background: #245b7c;
  transform: rotate(45deg);
  content: "";
}

.workshop-brand-rule {
  position: relative;
  width: 340rpx;
  height: 1rpx;
  margin-top: 18rpx;
  background: linear-gradient(90deg, transparent, rgba(196, 143, 76, 0.65) 20%, rgba(196, 143, 76, 0.45));
}

.workshop-brand-rule::after {
  position: absolute;
  right: 0;
  top: -7rpx;
  width: 42rpx;
  height: 13rpx;
  border-top: 1rpx solid #d5ad7c;
  border-bottom: 1rpx solid #d5ad7c;
  border-radius: 16rpx 0 16rpx 0;
  content: "";
}

.workshop-content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  display: flex;
  min-height: 944rpx;
  flex-direction: column;
  padding: 16rpx 28rpx 16rpx;
}

.entry-card {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--color-porcelain);
  border: 2rpx solid rgba(255, 252, 247, 0.92);
  box-shadow: 0 6rpx 18rpx rgba(34, 47, 50, 0.10);
  transition: transform 140ms ease, box-shadow 140ms ease;
}

.entry-card-pressed {
  transform: scale(0.985);
  box-shadow: 0 4rpx 12rpx rgba(34, 47, 50, 0.12);
}

.entry-primary {
  flex: none;
  height: 328rpx;
  border-radius: 22rpx;
}

.entry-primary .entry-wash {
  background:
    linear-gradient(90deg,
      rgba(8, 55, 84, 0.98) 0%,
      rgba(9, 59, 89, 0.94) 36%,
      rgba(10, 59, 87, 0.70) 50%,
      rgba(10, 55, 80, 0.14) 69%,
      transparent 82%),
    linear-gradient(0deg, rgba(8, 47, 70, 0.08), transparent 50%);
}

.entry-copy {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.entry-primary .entry-copy {
  width: 62%;
  padding: 34rpx 22rpx 28rpx 34rpx;
}

.entry-title {
  flex: none;
  font-family: var(--font-family-title);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.entry-primary .entry-title {
  color: #fffaf0;
  font-size: 60rpx;
  line-height: 1.14;
}

.entry-description {
  flex: none;
  font-family: var(--font-family-title);
  letter-spacing: 1rpx;
}

.entry-title-rule {
  flex: none;
  width: 36rpx;
  height: 4rpx;
  margin-top: 14rpx;
  background: #d59a4c;
  border-radius: 4rpx;
}

.entry-primary .entry-description {
  margin-top: 13rpx;
  color: rgba(255, 250, 240, 0.90);
  font-size: 24rpx;
  line-height: 1.48;
}

.entry-arrow-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-top: auto;
  color: var(--color-primary);
  background: rgba(255, 248, 235, 0.94);
  box-sizing: border-box;
  border: 2rpx solid #d4a05d;
  border-radius: 60rpx;
  font-family: var(--font-family-title);
  font-weight: 700;
  line-height: 1;
}

.entry-primary .entry-arrow-button {
  width: 216rpx;
  height: 60rpx;
  font-size: 28rpx;
}

.entry-action-arrow {
  margin-left: 16rpx;
  color: #c98c3f;
  font-family: Arial, sans-serif;
  font-size: 32rpx;
  font-weight: 400;
}

.entry-pair {
  display: flex;
  flex: none;
  gap: 18rpx;
  margin-top: 18rpx;
}

.entry-compact {
  flex: 1;
  min-width: 0;
  height: 300rpx;
  border-radius: 20rpx;
}

.entry-compact .entry-copy {
  width: 92%;
  padding: 24rpx 12rpx 20rpx 22rpx;
}

.entry-compact .entry-title {
  font-size: 42rpx;
  line-height: 1.18;
}

.entry-compact .entry-description {
  margin-top: 13rpx;
  font-size: 22rpx;
  line-height: 1.42;
}

.entry-compact .entry-arrow-button {
  width: 178rpx;
  height: 54rpx;
  font-size: 24rpx;
}

.entry-compact .entry-title-rule {
  width: 32rpx;
  margin-top: 14rpx;
}

.entry-secondary .entry-wash {
  background: linear-gradient(90deg,
    rgba(8, 52, 82, 0.98) 0%,
    rgba(9, 58, 88, 0.88) 38%,
    rgba(9, 55, 82, 0.48) 60%,
    rgba(9, 52, 76, 0.03) 88%);
}

.entry-secondary .entry-title,
.entry-secondary .entry-description {
  color: #fffaf0;
}

.entry-secondary .entry-description {
  color: rgba(255, 250, 240, 0.87);
}

.entry-collection .entry-image {
  top: 0;
  right: 0;
  bottom: 0;
  left: auto;
  width: auto;
  height: 100%;
}

.entry-collection .entry-wash {
  background: linear-gradient(90deg,
    rgba(247, 229, 200, 0.98) 0%,
    rgba(247, 229, 200, 0.88) 38%,
    rgba(247, 229, 200, 0.48) 65%,
    rgba(247, 229, 200, 0.08) 89%);
}

.entry-collection .entry-title {
  color: #3f342c;
}

.entry-collection .entry-description {
  color: rgba(63, 52, 44, 0.84);
}

.entry-collection .entry-arrow-button {
  color: #674221;
  background: rgba(255, 248, 235, 0.94);
}

.recent-section {
  flex: none;
  margin-top: auto;
  padding-top: 26rpx;
}

.recent-heading {
  display: flex;
  align-items: center;
  min-width: 0;
}

.recent-heading-icon {
  position: relative;
  flex: none;
  width: 46rpx;
  height: 46rpx;
}

.recent-heading-icon-crop {
  position: absolute;
  top: 3.98rpx;
  left: 0;
  width: 46rpx;
  height: 38.04rpx;
  overflow: hidden;
}

/* Original 941×1672 UI, displaying only its x38/y1165/52×43 lotus region. */
.recent-heading-icon-source {
  position: absolute;
  top: -1030.58rpx;
  left: -33.62rpx;
  width: 832.42rpx;
  height: auto;
}

.recent-heading-title {
  flex: none;
  margin-left: 10rpx;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.recent-heading-line {
  position: relative;
  flex: 1;
  min-width: 20rpx;
  height: 1rpx;
  margin-left: 18rpx;
  background: linear-gradient(90deg, rgba(49, 92, 114, 0.42), rgba(204, 157, 94, 0.45));
}

.recent-heading-line::after {
  position: absolute;
  right: 0;
  top: -7rpx;
  width: 52rpx;
  height: 14rpx;
  border-top: 1rpx solid #d5ad7c;
  border-bottom: 1rpx solid #d5ad7c;
  border-radius: 16rpx 0 16rpx 0;
  content: "";
}

.recent-scroll {
  width: 100%;
  height: 180rpx;
  margin-top: 14rpx;
  white-space: nowrap;
}

.recent-track {
  display: inline-flex;
  vertical-align: top;
  gap: 12rpx;
}

.recent-work-card {
  position: relative;
  flex: none;
  box-sizing: border-box;
  width: 164.5rpx;
  height: 180rpx;
  overflow: hidden;
  background: rgba(255, 252, 247, 0.96);
  border: 1rpx solid rgba(124, 103, 76, 0.12);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(43, 45, 42, 0.08);
}

.recent-work-image {
  display: block;
  width: 100%;
  height: 120rpx;
  background: #eee8dc;
}

.recent-work-copy {
  box-sizing: border-box;
  height: 60rpx;
  padding: 8rpx 8rpx 6rpx;
}

.recent-work-name {
  overflow: hidden;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-work-date {
  margin-top: 5rpx;
  color: var(--color-text-secondary);
  font-size: 19rpx;
  line-height: 1;
}

.recent-empty {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 180rpx;
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  overflow: hidden;
  background: rgba(255, 252, 247, 0.92);
  border: 1rpx solid rgba(49, 92, 114, 0.13);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(50, 47, 39, 0.05);
}

.recent-empty-mark {
  position: relative;
  z-index: 1;
  flex: none;
  width: 142rpx;
  height: 142rpx;
  overflow: hidden;
  background: #f4eee3;
  border: 3rpx double rgba(93, 139, 160, 0.36);
  border-radius: 50%;
}

.recent-empty-vase {
  position: absolute;
  left: -76rpx;
  top: -4rpx;
  width: 226rpx;
  height: 150rpx;
  opacity: 0.92;
}

.recent-empty-landscape {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  opacity: 0.09;
}

.recent-empty-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.recent-empty-title {
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.recent-empty-text {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.4;
}

.recent-empty-invitation {
  margin-top: 2rpx;
}

@media (max-width: 350px) {
  .workshop-brand {
    left: 30rpx;
  }

  .workshop-brand-title {
    font-size: 86rpx;
  }

  .workshop-brand-subtitle {
    font-size: 21rpx;
    letter-spacing: 1rpx;
  }

  .entry-primary .entry-copy {
    width: 64%;
    padding-left: 28rpx;
  }

  .entry-primary .entry-title {
    font-size: 58rpx;
  }

  .entry-compact .entry-copy {
    width: 94%;
    padding-left: 18rpx;
  }

  .entry-compact .entry-title {
    font-size: 40rpx;
  }

  .entry-compact .entry-description {
    font-size: 20rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .entry-card {
    transition: none;
  }
}
.recent-work-unavailable{display:flex;align-items:center;justify-content:center;color:#809298;font-size:21rpx;background:#eef1ed}
.recent-work-delete{position:absolute;right:0;top:0;z-index:2;display:flex;align-items:flex-start;justify-content:flex-end;box-sizing:border-box;min-width:44px;min-height:44px;padding:5rpx;color:#994f42;font-size:20rpx}
.recent-work-delete text{padding:4rpx 8rpx;background:#fffcf4;border-radius:8rpx}
.recent-work-count,.recent-work-error{color:#657f8e;font-size:22rpx}.recent-work-count{margin-left:12rpx}.recent-work-error{padding:12rpx 0;line-height:1.5}
