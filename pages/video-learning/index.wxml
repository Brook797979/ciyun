<view class="classroom-page">
  <view class="classroom-hero" style="height: {{heroHeight}}px">
    <image class="hero-background" src="/assets/backgrounds/video-classroom-header.jpg" mode="aspectFill"/>
    <view class="hero-wash"></view>

    <view class="classroom-nav" style="top: {{navTop}}px">
      <view class="nav-back" bindtap="goBack" aria-label="返回"><text>‹</text></view>
      <view class="nav-title">瓷艺课堂</view>
      <view class="share-wrap" aria-label="分享">
        <view class="share-icon"><view class="share-arrow"></view></view>
        <button class="share-trigger" open-type="share"></button>
      </view>
    </view>

    <view class="classroom-brand" style="top: {{brandTop}}px">
      <view class="brand-title">瓷艺课堂</view>
      <view class="brand-seal">非遗</view>
      <view class="brand-subtitle">影 像 记 录 千 年 制 瓷 技 艺</view>
    </view>
  </view>

  <view class="classroom-content">
    <swiper
      class="featured-swiper"
      indicator-dots="{{false}}"
      autoplay="{{playingVideoId === ''}}"
      interval="4500"
      duration="500"
      circular="{{true}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{carouselVideos}}" wx:key="id">
        <view class="featured-video" id="media-{{item.id}}">
          <block wx:if="{{playingVideoId === item.id}}">
            <video
              wx:if="{{!isSimulator}}"
              id="video-{{item.id}}"
              class="inline-video featured-player"
              src="{{item.playUrl}}"
              data-id="{{item.id}}"
              autoplay="{{true}}"
              controls="{{true}}"
              object-fit="contain"
              show-center-play-btn="{{false}}"
              show-background-playback-button="{{false}}"
              show-fullscreen-btn="{{true}}"
              direction="90"
              bindfullscreenchange="onVideoFullscreenChange"
              bindended="onVideoEnded"
              binderror="onVideoError"
            />
          </block>
          <view wx:else class="featured-poster" data-id="{{item.id}}" bindtap="playVideo">
            <image class="featured-cover" src="{{item.cover}}" mode="aspectFill"/>
            <view class="featured-shade"></view>
            <view class="featured-title">{{item.title}}</view>
            <view class="featured-play"><view class="play-triangle"></view></view>
            <view class="swiper-dots">
              <view
                wx:for="{{carouselVideos}}"
                wx:for-item="dot"
                wx:for-index="dotIndex"
                wx:key="id"
                class="swiper-dot {{currentSwiperIndex === dotIndex ? 'is-active' : ''}}"
              ></view>
            </view>
            <view class="video-duration featured-duration">{{item.duration}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view wx:if="{{isSimulator && playingVideoId && simulatorVideo.isCarousel}}" class="featured-player-action">
      <view class="player-action-title">{{simulatorVideo.title}}</view>
      <view class="expand-video-button" bindtap="enterSimulatorFullscreen" aria-role="button" aria-label="全屏播放">
        <view class="expand-video-symbol"></view>
      </view>
    </view>

    <view class="section-heading">
      <image class="section-icon" src="/assets/icons/home-section-classroom.png" mode="aspectFit"/>
      <view class="section-title">精选影像</view>
      <view class="section-rule"><view class="rule-knot"></view></view>
    </view>

    <view class="video-grid">
      <view wx:for="{{videos}}" wx:key="id" class="video-card">
        <view class="video-thumb" id="media-{{item.id}}">
          <block wx:if="{{playingVideoId === item.id}}">
            <video
              wx:if="{{!isSimulator}}"
              id="video-{{item.id}}"
              class="inline-video"
              src="{{item.playUrl}}"
              data-id="{{item.id}}"
              autoplay="{{true}}"
              controls="{{true}}"
              object-fit="contain"
              show-center-play-btn="{{false}}"
              show-background-playback-button="{{false}}"
              show-fullscreen-btn="{{true}}"
              direction="90"
              bindfullscreenchange="onVideoFullscreenChange"
              bindended="onVideoEnded"
              binderror="onVideoError"
            />
          </block>
          <view wx:else class="video-poster" data-id="{{item.id}}" bindtap="playVideo">
            <image class="video-cover" src="{{item.cover}}" mode="aspectFill"/>
            <view class="thumb-shade"></view>
            <view class="card-play"><view class="play-triangle"></view></view>
            <view class="video-duration">{{item.duration}}</view>
          </view>
        </view>
        <view class="video-copy">
          <view class="video-title">{{item.title}}</view>
          <view wx:if="{{isSimulator && playingVideoId === item.id}}" class="expand-video-button" bindtap="enterSimulatorFullscreen" aria-role="button" aria-label="全屏播放">
            <view class="expand-video-symbol"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<root-portal wx:if="{{isSimulator && playingVideoId}}">
  <view class="simulator-player {{simulatorVideo.isCarousel ? 'is-featured' : ''}} {{simulatorFullscreen ? 'is-fullscreen' : ''}}" style="{{simulatorFullscreen ? '' : simulatorPlayerStyle}}" catchtouchmove="preventPlayerScroll">
    <view wx:if="{{simulatorFullscreen}}" class="simulator-player-toolbar" style="padding-top: {{navTop}}px">
      <view class="simulator-player-back" bindtap="exitSimulatorFullscreen" aria-role="button" aria-label="退出全屏">‹ 返回</view>
      <view class="simulator-player-title">{{simulatorVideo.title}}</view>
    </view>
    <view class="simulator-player-media">
      <video
        id="video-{{playingVideoId}}"
        class="simulator-video"
        src="{{simulatorVideo.playUrl}}"
        data-id="{{playingVideoId}}"
        autoplay="{{true}}"
        controls="{{true}}"
        object-fit="contain"
        show-center-play-btn="{{false}}"
        show-background-playback-button="{{false}}"
        show-fullscreen-btn="{{false}}"
        show-progress="{{simulatorFullscreen}}"
        bindended="onVideoEnded"
        binderror="onVideoError"
      />
    </view>
  </view>
</root-portal>
