.news-page {
  min-height: 100vh;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background-color: var(--color-page);
  --paper-wash: linear-gradient(rgba(248, 241, 230, 0.92), rgba(248, 241, 230, 0.98));
}

.news-hero {
  position: relative;
  height: 230rpx;
  overflow: hidden;
}

.news-hero-image,
.news-hero-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.news-hero-wash {
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.10) 0%, rgba(248, 241, 230, 0.04) 66%, var(--color-page) 100%);
}

.back-button {
  position: absolute;
  z-index: 3;
  left: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  color: var(--color-ink-blue);
  background: transparent;
  border-radius: 50%;
}

.back-icon {
  margin-top: -5rpx;
  font-family: Arial, sans-serif;
  font-size: 58rpx;
  font-weight: 300;
  line-height: 1;
}

.news-brand {
  position: absolute;
  z-index: 2;
  left: 104rpx;
  right: 104rpx;
  text-align: center;
}

.news-brand-title {
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 2rpx rgba(255, 252, 247, 0.8);
}

.news-brand-subtitle {
  margin-top: 8rpx;
  color: rgba(7, 57, 88, 0.82);
  font-family: var(--font-family-title);
  font-size: 22rpx;
  line-height: 1.55;
  letter-spacing: 3rpx;
  white-space: nowrap;
}

.news-content {
  position: relative;
  z-index: 4;
  margin-top: -4rpx;
  padding: 0 var(--page-gutter);
}

.news-section + .news-section {
  margin-top: 26rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  margin-bottom: 14rpx;
}

.section-heading-icon,
.section-seal {
  flex: none;
  width: 42rpx;
  height: 42rpx;
}

.section-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--color-primary);
  border-radius: 50%;
  font-family: var(--font-family-title);
  font-size: 23rpx;
  box-shadow: 0 4rpx 10rpx rgba(7, 57, 88, 0.16);
}

.section-heading-title {
  flex: none;
  margin-left: 12rpx;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-heading-rule {
  position: relative;
  flex: 1;
  height: 1rpx;
  margin-left: 22rpx;
  background: linear-gradient(90deg, rgba(11, 65, 98, 0.38), rgba(11, 65, 98, 0));
}

.rule-knot {
  position: absolute;
  top: -5rpx;
  left: -10rpx;
  width: 9rpx;
  height: 9rpx;
  border: 1rpx solid rgba(11, 65, 98, 0.48);
  border-radius: 50%;
  transform: rotate(45deg);
}

.featured-card {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  background: var(--color-primary-soft);
  border: 1rpx solid rgba(7, 57, 88, 0.10);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(35, 42, 42, 0.13);
}

.featured-cover,
.featured-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.featured-overlay {
  background: linear-gradient(90deg, rgba(10, 29, 38, 0.94) 0%, rgba(10, 29, 38, 0.77) 42%, rgba(10, 29, 38, 0.18) 75%, rgba(10, 29, 38, 0.05) 100%);
}

.featured-copy {
  position: absolute;
  z-index: 2;
  top: 30rpx;
  left: 28rpx;
  width: 58%;
  color: #fffdf6;
}

.news-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 58rpx;
  height: 34rpx;
  padding: 0 16rpx;
  color: #704924;
  background: #f6e8cf;
  border-radius: 999rpx;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.featured-title {
  margin-top: 12rpx;
  font-family: var(--font-family-title);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.34;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.featured-summary {
  margin-top: 10rpx;
  color: rgba(255, 253, 246, 0.86);
  font-size: 20rpx;
  line-height: 1.45;
}

.featured-date {
  margin-top: 10rpx;
  color: rgba(255, 253, 246, 0.78);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.featured-arrow {
  position: absolute;
  z-index: 2;
  right: 22rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: var(--color-ink-blue);
  background: rgba(255, 252, 247, 0.94);
  border-radius: 50%;
  font-family: Arial, sans-serif;
  font-size: 42rpx;
  line-height: 1;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.16);
}

.latest-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.latest-card {
  position: relative;
  display: flex;
  min-height: 144rpx;
  overflow: hidden;
  background: rgba(255, 252, 247, 0.94);
  border: 1rpx solid rgba(217, 205, 187, 0.74);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(42, 48, 47, 0.07);
}

.latest-card::after {
  position: absolute;
  right: -22rpx;
  bottom: -26rpx;
  width: 118rpx;
  height: 72rpx;
  border: 2rpx solid rgba(70, 119, 151, 0.12);
  border-radius: 50% 50% 0 0;
  content: "";
  transform: rotate(-8deg);
}

.latest-media {
  flex: none;
  width: 244rpx;
  min-height: 144rpx;
  overflow: hidden;
  background: var(--color-primary-soft);
}

.latest-cover,
.news-cover-placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.news-cover-placeholder {
  position: relative;
  min-height: 144rpx;
  background:
    radial-gradient(circle at 50% 40%, rgba(11, 65, 98, 0.08), transparent 76rpx),
    linear-gradient(145deg, #f4eadb, #e8edf0);
}

.placeholder-vase {
  position: absolute;
  top: 29rpx;
  left: 50%;
  width: 58rpx;
  height: 78rpx;
  border: 3rpx solid rgba(11, 65, 98, 0.26);
  border-radius: 18rpx 18rpx 28rpx 28rpx;
  transform: translateX(-50%);
}

.latest-copy {
  flex: 1;
  min-width: 0;
  padding: 10rpx 48rpx 8rpx 20rpx;
}

.latest-tag {
  height: 28rpx;
  padding: 0 14rpx;
  font-size: 18rpx;
}

.latest-title {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latest-summary {
  display: -webkit-box;
  margin-top: 3rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 19rpx;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.latest-date {
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  font-size: 18rpx;
}

.latest-arrow {
  position: absolute;
  top: 50%;
  right: 16rpx;
  color: var(--color-ink-blue);
  font-family: Arial, sans-serif;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  transform: translateY(-50%);
}

@media (max-width: 350px) {
  .news-brand {
    left: 90rpx;
    right: 90rpx;
  }

  .news-brand-title {
    font-size: 39rpx;
  }

  .news-brand-subtitle {
    font-size: 20rpx;
    letter-spacing: 1rpx;
  }

  .featured-card {
    height: 294rpx;
  }

  .featured-title {
    font-size: 29rpx;
  }

  .latest-media {
    width: 214rpx;
  }

  .latest-copy {
    padding-left: 18rpx;
  }

  .latest-title {
    font-size: 23rpx;
  }
}
