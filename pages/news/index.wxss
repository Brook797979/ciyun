.news-page {
  min-height: 100vh;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background:
    linear-gradient(rgba(248, 241, 230, 0.92), rgba(248, 241, 230, 0.98)),
    url("/assets/backgrounds/home-paper.png") repeat;
  background-size: auto, 512rpx 512rpx;
}

.news-hero {
  position: relative;
  height: 390rpx;
  overflow: hidden;
}

.news-hero-image,
.news-hero-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.news-hero-wash {
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.10) 0%, rgba(248, 241, 230, 0.04) 66%, var(--color-page) 100%);
}

.back-button {
  position: absolute;
  z-index: 3;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  color: var(--color-ink-blue);
  background: rgba(255, 252, 247, 0.68);
  border-radius: 50%;
  box-shadow: 0 5rpx 16rpx rgba(7, 57, 88, 0.10);
}

.back-icon {
  margin-top: -5rpx;
  font-family: Arial, sans-serif;
  font-size: 66rpx;
  font-weight: 300;
  line-height: 1;
}

.news-brand {
  position: absolute;
  z-index: 2;
  top: calc(env(safe-area-inset-top) + 86rpx);
  left: 120rpx;
  right: 120rpx;
  text-align: center;
}

.news-brand-title {
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 2rpx rgba(255, 252, 247, 0.8);
}

.news-brand-subtitle {
  margin-top: 20rpx;
  color: rgba(7, 57, 88, 0.82);
  font-family: var(--font-family-title);
  font-size: 25rpx;
  line-height: 1.55;
  letter-spacing: 3rpx;
  white-space: nowrap;
}

.news-content {
  position: relative;
  z-index: 4;
  margin-top: -28rpx;
  padding: 0 var(--page-gutter);
}

.news-section + .news-section {
  margin-top: 42rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  margin-bottom: 20rpx;
}

.section-heading-icon,
.section-seal {
  flex: none;
  width: 48rpx;
  height: 48rpx;
}

.section-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--color-primary);
  border-radius: 50%;
  font-family: var(--font-family-title);
  font-size: 23rpx;
  box-shadow: 0 4rpx 10rpx rgba(7, 57, 88, 0.16);
}

.section-heading-title {
  flex: none;
  margin-left: 14rpx;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-heading-rule {
  position: relative;
  flex: 1;
  height: 1rpx;
  margin-left: 26rpx;
  background: linear-gradient(90deg, rgba(11, 65, 98, 0.38), rgba(11, 65, 98, 0));
}

.rule-knot {
  position: absolute;
  top: -5rpx;
  left: -10rpx;
  width: 9rpx;
  height: 9rpx;
  border: 1rpx solid rgba(11, 65, 98, 0.48);
  border-radius: 50%;
  transform: rotate(45deg);
}

.featured-card {
  position: relative;
  height: 450rpx;
  overflow: hidden;
  background: var(--color-primary-soft);
  border: 1rpx solid rgba(7, 57, 88, 0.10);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(35, 42, 42, 0.14);
}

.featured-cover,
.featured-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.featured-overlay {
  background: linear-gradient(90deg, rgba(10, 29, 38, 0.94) 0%, rgba(10, 29, 38, 0.77) 42%, rgba(10, 29, 38, 0.18) 75%, rgba(10, 29, 38, 0.05) 100%);
}

.featured-copy {
  position: absolute;
  z-index: 2;
  top: 46rpx;
  left: 34rpx;
  width: 61%;
  color: #fffdf6;
}

.news-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 42rpx;
  padding: 0 18rpx;
  color: #704924;
  background: #f6e8cf;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.featured-title {
  margin-top: 20rpx;
  font-family: var(--font-family-title);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.38;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.featured-summary {
  display: -webkit-box;
  margin-top: 16rpx;
  overflow: hidden;
  color: rgba(255, 253, 246, 0.86);
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.featured-date {
  margin-top: 18rpx;
  color: rgba(255, 253, 246, 0.78);
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.featured-arrow {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  bottom: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: var(--color-ink-blue);
  background: rgba(255, 252, 247, 0.94);
  border-radius: 50%;
  font-family: Arial, sans-serif;
  font-size: 52rpx;
  line-height: 1;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.16);
}

.latest-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.latest-card {
  position: relative;
  display: flex;
  min-height: 196rpx;
  overflow: hidden;
  background: rgba(255, 252, 247, 0.94);
  border: 1rpx solid rgba(217, 205, 187, 0.74);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(42, 48, 47, 0.08);
}

.latest-media {
  flex: none;
  width: 238rpx;
  min-height: 196rpx;
  overflow: hidden;
  background: var(--color-primary-soft);
}

.latest-cover,
.news-cover-placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.news-cover-placeholder {
  position: relative;
  min-height: 196rpx;
  background:
    radial-gradient(circle at 50% 40%, rgba(11, 65, 98, 0.08), transparent 76rpx),
    linear-gradient(145deg, #f4eadb, #e8edf0);
}

.placeholder-vase {
  position: absolute;
  top: 48rpx;
  left: 50%;
  width: 58rpx;
  height: 88rpx;
  border: 3rpx solid rgba(11, 65, 98, 0.26);
  border-radius: 18rpx 18rpx 28rpx 28rpx;
  transform: translateX(-50%);
}

.latest-copy {
  flex: 1;
  min-width: 0;
  padding: 18rpx 54rpx 16rpx 22rpx;
}

.latest-tag {
  height: 36rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.latest-title {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.42;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latest-summary {
  display: -webkit-box;
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.latest-date {
  margin-top: 5rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
}

.latest-arrow {
  position: absolute;
  top: 50%;
  right: 18rpx;
  color: var(--color-ink-blue);
  font-family: Arial, sans-serif;
  font-size: 45rpx;
  font-weight: 300;
  line-height: 1;
  transform: translateY(-50%);
}

@media (max-width: 350px) {
  .news-brand {
    left: 96rpx;
    right: 96rpx;
  }

  .news-brand-title {
    font-size: 45rpx;
  }

  .news-brand-subtitle {
    font-size: 22rpx;
    letter-spacing: 2rpx;
  }

  .featured-card {
    height: 430rpx;
  }

  .featured-title {
    font-size: 36rpx;
  }

  .latest-media {
    width: 214rpx;
  }

  .latest-copy {
    padding-left: 18rpx;
  }

  .latest-title {
    font-size: 26rpx;
  }
}
