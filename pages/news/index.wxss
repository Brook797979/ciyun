.news-page{overflow:hidden}.news-swiper{height:820rpx;margin-top:28rpx}.news-slide{overflow:hidden;height:744rpx;margin:0 8rpx;background:var(--color-surface);border:1rpx solid var(--color-border);border-radius:var(--radius-card-lg);box-shadow:var(--shadow-card)}.news-cover{display:block;width:100%;height:390rpx;background:var(--color-primary-soft)}.news-body{padding:28rpx}.news-meta{display:flex;align-items:center;justify-content:space-between}.news-tag{padding:7rpx 20rpx;color:#81552f;background:#f7ead4;border-radius:999rpx;font-size:23rpx}.news-date{color:var(--color-text-tertiary);font-size:23rpx}.news-title{margin-top:22rpx;color:var(--color-ink-blue);font-family:var(--font-family-title);font-size:36rpx;font-weight:700;line-height:1.45}.news-summary{margin-top:16rpx;color:var(--color-text-secondary);font-size:26rpx;line-height:1.65}.news-action{margin-top:22rpx;color:var(--color-primary);font-size:25rpx}.swiper-hint{text-align:center;color:var(--color-text-tertiary);font-size:22rpx}
