<view class="page-shell news-page"><section-title title="陶瓷资讯" description="文化、非遗、展览与传统工艺"/><swiper class="news-swiper" current="{{current}}" circular indicator-dots autoplay="{{false}}" bindchange="onChange"><swiper-item wx:for="{{news}}" wx:key="id"><view class="news-slide" data-id="{{item.id}}" bindtap="openDetail"><image class="news-cover" src="{{item.cover}}" mode="aspectFill"/><view class="news-body"><view class="news-meta"><text class="news-tag">{{item.category}}</text><text class="news-date">{{item.publishedAt}}</text></view><view class="news-title">{{item.title}}</view><view class="news-summary">{{item.summary}}</view><view class="news-action">查看详情 <text>›</text></view></view></view></swiper-item></swiper><view class="swiper-hint">左右滑动，浏览更多瓷韵新知</view></view>
