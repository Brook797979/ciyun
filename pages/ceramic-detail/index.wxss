.ceramic-detail-page {
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--color-ink-blue);
  background:
    linear-gradient(rgba(248, 241, 230, 0.91), rgba(248, 241, 230, 0.97)),
    url("/assets/backgrounds/home-paper.png") repeat-y;
  background-size: auto, 100% auto;
}

.detail-header {
  position: relative;
  overflow: hidden;
  background: var(--color-silk);
}

.detail-header-image,
.detail-header-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-header-image {
  transform: scale(1.02);
}

.detail-header-wash {
  background:
    linear-gradient(90deg, rgba(248, 241, 230, 0.45) 0%, rgba(248, 241, 230, 0.10) 56%, rgba(248, 241, 230, 0.03) 100%),
    linear-gradient(180deg, rgba(255, 252, 247, 0.08) 50%, rgba(248, 241, 230, 0.92) 100%);
}

.detail-nav {
  position: absolute;
  z-index: 3;
  right: 0;
  left: 0;
}

.detail-nav-title {
  position: absolute;
  right: 150rpx;
  left: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
  text-shadow: 0 2rpx 2rpx rgba(255, 252, 247, 0.74);
}

.back-button {
  position: absolute;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 100%;
}

.back-icon {
  box-sizing: border-box;
  width: 25rpx;
  height: 25rpx;
  border-bottom: 4rpx solid var(--color-ink-blue);
  border-left: 4rpx solid var(--color-ink-blue);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.detail-content {
  box-sizing: border-box;
  padding: 8rpx 0 calc(16rpx + env(safe-area-inset-bottom));
}

.ceramic-hero {
  position: relative;
  margin: 0 22rpx;
}

.ceramic-hero-image {
  display: block;
  width: 100%;
  height: 540rpx;
  background: var(--color-primary-soft);
  border: 1rpx solid rgba(255, 252, 247, 0.68);
  border-radius: 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(43, 38, 31, 0.15);
}

.hero-cloud-decoration {
  position: absolute;
  bottom: -17rpx;
  left: -35rpx;
  width: 196rpx;
  height: 112rpx;
  opacity: 0.72;
  background:
    radial-gradient(ellipse at 18% 70%, transparent 0 28%, #5b83a2 30% 33%, transparent 35%),
    radial-gradient(ellipse at 48% 56%, transparent 0 31%, #315f82 33% 36%, transparent 38%),
    radial-gradient(ellipse at 79% 72%, transparent 0 27%, #6e91ad 29% 32%, transparent 34%);
  filter: drop-shadow(0 1rpx 0 rgba(183, 137, 85, 0.70));
  pointer-events: none;
}

.collection-info {
  position: relative;
  box-sizing: border-box;
  padding: 38rpx 46rpx 0;
}

.collection-info::after {
  position: absolute;
  right: -28rpx;
  bottom: -35rpx;
  width: 260rpx;
  height: 132rpx;
  opacity: 0.09;
  background:
    radial-gradient(ellipse at 16% 92%, transparent 0 30%, var(--color-primary) 31% 34%, transparent 35%),
    radial-gradient(ellipse at 53% 78%, transparent 0 36%, var(--color-primary) 37% 40%, transparent 41%),
    radial-gradient(ellipse at 91% 95%, transparent 0 28%, var(--color-primary) 29% 32%, transparent 33%);
  content: "";
  pointer-events: none;
}

.collection-name-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.collection-name {
  min-width: 0;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.collection-seal {
  flex: none;
  box-sizing: border-box;
  width: 31rpx;
  padding: 6rpx 4rpx;
  color: #fff8eb;
  background: var(--color-cinnabar);
  border-radius: 6rpx;
  font-family: var(--font-family-title);
  font-size: 14rpx;
  line-height: 1.05;
  letter-spacing: 1rpx;
  text-align: center;
}

.collection-meta {
  position: relative;
  z-index: 1;
  margin-top: 15rpx;
  color: rgba(7, 57, 88, 0.88);
  font-family: var(--font-family-title);
  font-size: 26rpx;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.collection-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 13rpx;
  margin-top: 19rpx;
}

.collection-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 108rpx;
  height: 45rpx;
  padding: 0 28rpx;
  color: var(--color-ink-blue);
  background: rgba(255, 252, 247, 0.44);
  border: 1rpx solid rgba(11, 65, 98, 0.30);
  border-radius: 999rpx;
  font-family: var(--font-family-title);
  font-size: 22rpx;
  line-height: 1;
}

.detail-section {
  box-sizing: border-box;
  padding: 0 46rpx;
}

.introduction-section {
  margin-top: 31rpx;
}

.related-section {
  margin-top: 25rpx;
  padding-right: 26rpx;
  padding-left: 26rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 48rpx;
}

.section-emblem {
  position: relative;
  flex: none;
  width: 40rpx;
  height: 35rpx;
  margin-right: 12rpx;
  color: var(--color-primary);
}

.section-emblem::before,
.section-emblem::after,
.emblem-core {
  position: absolute;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  content: "";
}

.section-emblem::before {
  top: 12rpx;
  left: 0;
  width: 23rpx;
  height: 18rpx;
}

.section-emblem::after {
  top: 3rpx;
  right: 1rpx;
  width: 25rpx;
  height: 25rpx;
}

.emblem-core {
  right: 9rpx;
  bottom: 0;
  width: 24rpx;
  height: 17rpx;
  border-top-color: transparent;
}

.section-title {
  flex: none;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 2rpx;
}

.section-knot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-left: 18rpx;
  border: 1rpx solid rgba(11, 65, 98, 0.38);
  border-radius: 50%;
}

.section-line {
  flex: 1;
  min-width: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(11, 65, 98, 0.34), rgba(11, 65, 98, 0.10));
}

.collection-description {
  margin-top: 19rpx;
  color: rgba(34, 57, 70, 0.88);
  font-family: var(--font-family-title);
  font-size: 26rpx;
  line-height: 1.82;
  letter-spacing: 1rpx;
  text-align: justify;
}

.related-section .section-heading {
  margin-right: 20rpx;
  margin-left: 20rpx;
}

.related-video {
  position: relative;
  display: grid;
  grid-template-columns: 38% minmax(0, 1fr);
  box-sizing: border-box;
  height: 150rpx;
  margin-top: 15rpx;
  overflow: hidden;
  background: rgba(255, 252, 247, 0.78);
  border: 1rpx solid rgba(178, 157, 130, 0.34);
  border-radius: 19rpx;
  box-shadow: 0 5rpx 15rpx rgba(68, 53, 39, 0.07);
}

.related-video-cover {
  position: relative;
  min-width: 0;
  height: 150rpx;
  overflow: hidden;
}

.related-video-image,
.related-video-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.related-video-shade {
  background: linear-gradient(90deg, rgba(9, 22, 29, 0.08), rgba(9, 22, 29, 0.22));
}

.video-play {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 51rpx;
  height: 51rpx;
  background: rgba(20, 34, 40, 0.52);
  border: 2rpx solid rgba(255, 252, 247, 0.88);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.video-play-triangle {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  border-left: 14rpx solid #fffdf8;
}

.video-duration {
  position: absolute;
  right: 8rpx;
  bottom: 7rpx;
  padding: 3rpx 8rpx;
  color: #fffdf8;
  background: rgba(12, 20, 24, 0.72);
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 1.2;
}

.related-video-copy {
  position: relative;
  z-index: 2;
  align-self: center;
  min-width: 0;
  padding: 0 22rpx;
}

.related-video-title {
  overflow: hidden;
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-video-description {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.related-video-decoration {
  position: absolute;
  right: -20rpx;
  bottom: -23rpx;
  width: 124rpx;
  height: 70rpx;
  opacity: 0.10;
  background:
    radial-gradient(ellipse at 22% 78%, transparent 0 29%, var(--color-primary) 31% 34%, transparent 36%),
    radial-gradient(ellipse at 58% 60%, transparent 0 33%, var(--color-primary) 35% 38%, transparent 40%);
}

.ai-entry {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 92rpx;
  margin: 16rpx 26rpx 0;
  padding: 0 24rpx 0 20rpx;
  overflow: hidden;
  background: linear-gradient(105deg, rgba(229, 241, 244, 0.95), rgba(247, 250, 247, 0.90));
  border: 1rpx solid rgba(11, 65, 98, 0.15);
  border-radius: 19rpx;
  box-shadow: 0 5rpx 15rpx rgba(68, 53, 39, 0.07);
}

.ai-entry:active {
  background: rgba(237, 244, 245, 0.90);
}

.ai-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background:
    radial-gradient(circle at 28% 24%, #fff 0 5%, transparent 6%),
    linear-gradient(145deg, #f6fbfb, #b8d0de);
  border: 1rpx solid rgba(11, 65, 98, 0.24);
  border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.45);
}

.ai-bubble {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 28rpx;
  color: var(--color-primary);
  background: rgba(255, 252, 247, 0.93);
  border: 1rpx solid rgba(11, 65, 98, 0.24);
  border-radius: 14rpx;
}

.ai-bubble::after {
  position: absolute;
  right: 5rpx;
  bottom: -5rpx;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 252, 247, 0.93);
  border-right: 1rpx solid rgba(11, 65, 98, 0.24);
  border-bottom: 1rpx solid rgba(11, 65, 98, 0.24);
  content: "";
  transform: rotate(35deg);
}

.ai-dots {
  margin-top: -5rpx;
  font-family: Arial, sans-serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ai-divider {
  flex: none;
  width: 1rpx;
  height: 44rpx;
  margin: 0 18rpx;
  background: rgba(11, 65, 98, 0.18);
}

.ai-copy {
  flex: 1;
  min-width: 0;
}

.ai-title {
  color: var(--color-ink-blue);
  font-family: var(--font-family-title);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.25;
}

.ai-description {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-arrow {
  flex: none;
  margin-left: 16rpx;
  color: var(--color-primary);
  font-family: Arial, sans-serif;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

@media (max-width: 350px) {
  .ceramic-hero {
    margin-right: 18rpx;
    margin-left: 18rpx;
  }

  .collection-info,
  .detail-section {
    padding-right: 36rpx;
    padding-left: 36rpx;
  }

  .collection-name {
    font-size: 40rpx;
  }

  .collection-meta,
  .collection-description {
    font-size: 24rpx;
  }

  .collection-tag {
    min-width: 96rpx;
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .related-section {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .related-video-copy {
    padding-right: 14rpx;
    padding-left: 14rpx;
  }

  .related-video-title {
    font-size: 24rpx;
  }

  .related-video-description {
    font-size: 18rpx;
  }

  .ai-entry {
    margin-right: 20rpx;
    margin-left: 20rpx;
  }
}
