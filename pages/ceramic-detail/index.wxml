<view class="ceramic-detail-page paper-texture-page">
  <view class="paper-texture" aria-hidden="true"><image class="paper-texture-image" src="/assets/backgrounds/home-paper.png" mode="aspectFill"/></view>
  <view class="detail-header" style="height: {{heroHeight}}px">
    <image class="detail-header-image" src="/assets/banners/home-hero.jpg" mode="aspectFill"/>
    <view class="detail-header-wash"></view>
    <view class="detail-nav" style="top: {{navTop}}px; height: {{navHeight}}px">
      <view class="back-button" bindtap="goBack" aria-role="button" aria-label="返回瓷馆">
        <view class="back-icon"></view>
      </view>
      <view class="detail-nav-title">瓷器详情</view>
    </view>
  </view>

  <view class="detail-content">
    <view class="ceramic-hero">
      <image class="ceramic-hero-image" src="{{item.image}}" mode="aspectFit" bindtap="previewCeramic" aria-role="button" aria-label="查看{{item.name}}完整大图"/>
      <view class="hero-cloud-decoration" aria-hidden="true"></view>
    </view>

    <view class="collection-info">
      <view class="collection-name-row">
        <view class="collection-name">{{item.name}}</view>
        <view class="collection-seal">瓷韵</view>
      </view>
      <view class="collection-meta">{{item.dynasty}} · {{item.type}} · {{item.category}}</view>
      <view class="collection-tags">
        <view wx:for="{{item.tags}}" wx:key="*this" class="collection-tag">{{item}}</view>
      </view>
    </view>

    <view class="detail-section introduction-section">
      <view class="section-heading">
        <view class="section-emblem" aria-hidden="true"><view class="emblem-core"></view></view>
        <view class="section-title">藏品简介</view>
        <view class="section-knot"></view>
        <view class="section-line"></view>
      </view>
      <view class="collection-description">{{item.description}}</view>
    </view>

    <view class="detail-section related-section">
      <view class="section-heading">
        <view class="section-emblem" aria-hidden="true"><view class="emblem-core"></view></view>
        <view class="section-title">相关影像</view>
        <view class="section-knot"></view>
        <view class="section-line"></view>
      </view>

      <view class="related-video {{videoUrl ? 'related-video-active' : ''}}">
        <view class="related-video-cover">
          <video wx:if="{{videoUrl}}" id="ceramic-detail-video" class="related-video-player" src="{{videoUrl}}" poster="{{item.video.cover}}" object-fit="contain" autoplay="{{false}}" controls="{{true}}" show-center-play-btn="{{true}}" binderror="onVideoError" bindplay="onVideoPlay"/>
          <view wx:else class="related-video-trigger" bindtap="playRelatedVideo" aria-role="button" aria-label="{{!item.video.src ? '影像待补充' : videoState === 'error' ? '影像播放失败，点击重试' : '播放相关影像'}}" aria-disabled="{{!item.video.src || videoState === 'loading'}}">
            <image class="related-video-image" src="{{item.video.cover}}" mode="aspectFit"/>
            <view class="related-video-shade"></view>
            <view wx:if="{{!item.video.src}}" class="video-status">影像待补充</view>
            <view wx:elif="{{videoState === 'loading'}}" class="video-status">影像加载中…</view>
            <view wx:elif="{{videoState === 'error'}}" class="video-status video-status-error">{{videoError}}<text class="video-retry">点击重试</text></view>
            <block wx:else>
              <view class="video-play" aria-hidden="true"><view class="video-play-triangle"></view></view>
              <view class="video-duration">{{item.video.duration}}</view>
            </block>
          </view>
        </view>
        <view class="related-video-copy">
          <view class="related-video-title">{{item.video.title}}</view>
          <view class="related-video-description">{{item.video.description}}</view>
        </view>
        <view class="related-video-decoration" aria-hidden="true"></view>
      </view>
    </view>

    <view class="ai-entry" bindtap="ask" hover-class="ai-entry-pressed" aria-role="button" aria-label="AI深度解读，探索这件藏品背后的历史与纹样">
      <image class="ai-cloud" src="/assets/icons/identify-cloud.svg" mode="aspectFit" aria-hidden="true"/>
      <view class="ai-icon" aria-hidden="true"><image class="ai-lotus" src="/assets/icons/ai-reading-lotus.svg" mode="aspectFit"/></view>
      <view class="ai-divider"></view>
      <view class="ai-copy">
        <view class="ai-title">AI深度解读</view>
        <view class="ai-description">探索这件藏品背后的历史与纹样</view>
      </view>
      <view class="ai-arrow" aria-hidden="true"></view>
    </view>
  </view>
</view>
